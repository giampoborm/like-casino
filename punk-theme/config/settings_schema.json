[
  {
    "name": "theme_info",
    "theme_name": "Elena Store — Punk",
    "theme_version": "1.0.0",
    "theme_author": "Gianpaolo",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "Branding",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo",
        "info": "Gift card page"
      },
      {
        "type": "header",
        "content": "Colours"
      },
      {
        "type": "select",
        "id": "text_theme",
        "label": "Text colour",
        "options": [
          { "value": "positive", "label": "Positive (dark ink)" },
          { "value": "negative", "label": "Negative (ivory)" }
        ],
        "default": "positive"
      },
      {
        "type": "color",
        "id": "color_positive",
        "label": "Positive",
        "default": "#2a2622"
      },
      {
        "type": "color",
        "id": "color_negative",
        "label": "Negative",
        "default": "#efe6d2"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent",
        "info": "Sold out, discounts",
        "default": "#7a1f1a"
      },
      {
        "type": "header",
        "content": "Fonts"
      },
      {
        "type": "checkbox",
        "id": "font_main_bundled",
        "label": "Bundled main font",
        "default": true
      },
      {
        "type": "font_picker",
        "id": "font_main",
        "label": "Main font",
        "default": "assistant_n4",
        "visible_if": "{{ settings.font_main_bundled == false }}"
      },
      {
        "type": "checkbox",
        "id": "font_stamp_bundled",
        "label": "Bundled stamp font",
        "default": true
      },
      {
        "type": "font_picker",
        "id": "font_stamp",
        "label": "Stamp font",
        "default": "assistant_n7",
        "visible_if": "{{ settings.font_stamp_bundled == false }}"
      },
      {
        "type": "header",
        "content": "Text effect"
      },
      {
        "type": "select",
        "id": "text_effect",
        "label": "Effect on text",
        "options": [
          { "value": "none", "label": "None" },
          { "value": "ink", "label": "Ink bleed" },
          { "value": "shadow", "label": "Dark shadow" }
        ],
        "default": "ink"
      },
      {
        "type": "range",
        "id": "ink_bleed_strength",
        "min": 1,
        "max": 5,
        "step": 1,
        "unit": "px",
        "label": "Ink bleed strength",
        "default": 2,
        "visible_if": "{{ settings.text_effect == 'ink' }}"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "Site background",
    "settings": [
      {
        "type": "select",
        "id": "background_preset",
        "label": "Background",
        "options": [
          { "value": "1", "label": "Sfondo prova 1" },
          { "value": "2", "label": "Sfondo prova 2" },
          { "value": "3", "label": "Sfondo prova 3" },
          { "value": "4", "label": "Sfondo prova 4" },
          { "value": "5", "label": "Sfondo prova 5" },
          { "value": "6", "label": "Sfondo prova 6" },
          { "value": "wallbackground", "label": "Wall background" },
          { "value": "wallbackground2", "label": "Wall background 2" },
          { "value": "custom", "label": "Custom upload" }
        ],
        "default": "4"
      },
      {
        "type": "image_picker",
        "id": "background_image",
        "label": "Custom background image",
        "visible_if": "{{ settings.background_preset == 'custom' }}"
      },
      {
        "type": "color",
        "id": "background_color",
        "default": "#111111",
        "label": "Background color"
      },
      {
        "type": "select",
        "id": "background_fit",
        "label": "Image fit",
        "options": [
          { "value": "cover", "label": "Fill the screen (crop)" },
          { "value": "contain", "label": "Fit inside the screen" },
          { "value": "zoom", "label": "Custom zoom" }
        ],
        "default": "cover"
      },
      {
        "type": "range",
        "id": "background_zoom",
        "min": 50,
        "max": 400,
        "step": 5,
        "unit": "%",
        "label": "Zoom",
        "default": 100,
        "visible_if": "{{ settings.background_fit == 'zoom' }}"
      },
      {
        "type": "range",
        "id": "background_position_x",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "%",
        "label": "Horizontal position",
        "default": 50
      },
      {
        "type": "range",
        "id": "background_position_y",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "%",
        "label": "Vertical position",
        "default": 0
      },
      {
        "type": "range",
        "id": "background_overlay",
        "min": 0,
        "max": 90,
        "step": 5,
        "unit": "%",
        "label": "Darken image",
        "default": 0
      },
      {
        "type": "select",
        "id": "background_repeat",
        "label": "Image repeat",
        "options": [
          { "value": "no-repeat", "label": "No repeat" },
          { "value": "repeat", "label": "Tile both ways" },
          { "value": "repeat-y", "label": "Tile vertically" },
          { "value": "repeat-x", "label": "Tile horizontally" }
        ],
        "default": "no-repeat"
      },
      {
        "type": "select",
        "id": "background_attachment",
        "label": "Scrolling",
        "options": [
          { "value": "fixed", "label": "Stays still while scrolling" },
          { "value": "scroll", "label": "Scrolls with the page" }
        ],
        "default": "fixed"
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  }
]
