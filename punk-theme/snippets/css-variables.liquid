{%- comment -%}
  Theme fonts, colours and the site-wide background, as CSS variables on :root.
  The bundled fonts are declared here (not in critical.css) so their URLs are the versioned
  asset URLs: the same ones the layout preloads, and they refresh when a font file is replaced.
{%- endcomment -%}
{% style %}
  {%- if settings.font_main_bundled %}
  @font-face {
    font-family: 'MainFont';
    src: url('{{ 'cella.regular.otf' | asset_url }}') format('opentype');
    font-display: swap;
  }
  {%- else %}
  {{ settings.font_main | font_face: font_display: 'swap' }}
  {%- endif %}
  {%- if settings.font_stamp_bundled %}
  @font-face {
    font-family: 'StampFont';
    src: url('{{ 'octin-spraypaint.otf' | asset_url }}') format('opentype');
    font-display: swap;
  }
  {%- else %}
  {{ settings.font_stamp | font_face: font_display: 'swap' }}
  {%- endif %}
  :root {
    {%- if settings.font_main_bundled %}
    --font-main--family: 'MainFont', serif;
    --font-main--style: normal;
    --font-main--weight: 400;
    {%- else %}
    --font-main--family: {{ settings.font_main.family }}, {{ settings.font_main.fallback_families }};
    --font-main--style: {{ settings.font_main.style }};
    --font-main--weight: {{ settings.font_main.weight }};
    {%- endif %}
    {%- if settings.font_stamp_bundled %}
    --font-stamp--family: 'StampFont', sans-serif;
    --font-stamp--style: normal;
    --font-stamp--weight: 400;
    {%- else %}
    --font-stamp--family: {{ settings.font_stamp.family }}, {{ settings.font_stamp.fallback_families }};
    --font-stamp--style: {{ settings.font_stamp.style }};
    --font-stamp--weight: {{ settings.font_stamp.weight }};
    {%- endif %}
    --color-positive: {{ settings.color_positive }};
    --color-negative: {{ settings.color_negative }};
    --color-accent: {{ settings.color_accent }};
    {%- comment -%} Text theme: positive = dark ink, negative = ivory. Inverse is the opposite, for hover fills. {%- endcomment %}
    {%- if settings.text_theme == 'positive' %}
    --color-text: var(--color-positive);
    --color-text-inverse: var(--color-negative);
    {%- else %}
    --color-text: var(--color-negative);
    --color-text-inverse: var(--color-positive);
    {%- endif %}
    {%- case settings.text_effect %}
      {%- when 'ink' %}
    {%- assign ink_blur = settings.ink_bleed_strength | default: 2 -%}
    --text-effect: 0 0 {{ ink_blur }}px color-mix(in srgb, var(--color-text) 70%, transparent), 0 0 {{ ink_blur | times: 3 }}px color-mix(in srgb, var(--color-text) 40%, transparent);
      {%- when 'none' %}
    --text-effect: none;
      {%- else %}
    --text-effect: 0 2px 8px rgba(0, 0, 0, 0.85), 0 1px 3px rgba(0, 0, 0, 0.6);
    {%- endcase %}
    --page-width: {{ settings.max_page_width }};
    --page-margin: {{ settings.min_page_margin }}px;
    --color-background: {{ settings.background_color }};
    {%- comment -%} GLOBAL SITE BACKGROUND — all values come from Theme settings → Site background. {%- endcomment -%}
    {%- comment -%}
      The image is requested in three widths (phone / default / wide screen, see the media queries
      under :root) so a phone never downloads the desktop file. A landscape image is cropped to a
      tall phone screen by its height, so it needs more pixels there than a portrait one.
    {%- endcomment -%}
    {%- liquid
      assign bg_file = 'sfondoprova6.png'
      assign bg_landscape = false
      if settings.background_preset == 'custom'
        if settings.background_image and settings.background_image.aspect_ratio > 1
          assign bg_landscape = true
        endif
      elsif settings.background_preset contains 'wallbackground'
        assign bg_file = settings.background_preset | append: '.png'
        assign bg_landscape = true
      else
        assign bg_file = 'sfondoprova' | append: settings.background_preset | append: '.png'
      endif

      assign bg_w_small = 1200
      if bg_landscape
        assign bg_w_small = 1600
      endif
      assign bg_w = 1600
      assign bg_w_large = 2400

      if settings.background_preset == 'custom' and settings.background_image
        assign bg_url_small = settings.background_image | image_url: width: bg_w_small
        assign bg_url = settings.background_image | image_url: width: bg_w
        assign bg_url_large = settings.background_image | image_url: width: bg_w_large
      else
        assign bg_size_small = bg_w_small | append: 'x'
        assign bg_size = bg_w | append: 'x'
        assign bg_size_large = bg_w_large | append: 'x'
        assign bg_url_small = bg_file | asset_img_url: bg_size_small
        assign bg_url = bg_file | asset_img_url: bg_size
        assign bg_url_large = bg_file | asset_img_url: bg_size_large
      endif
    -%}
    {%- assign bg_overlay = settings.background_overlay | divided_by: 100.0 %}
    {%- capture bg_gradient -%}linear-gradient(rgba(0, 0, 0, {{ bg_overlay }}), rgba(0, 0, 0, {{ bg_overlay }})){%- endcapture %}
    --site-background-image: {{ bg_gradient }}, url({{ bg_url }});
    {%- if settings.background_fit == 'zoom' %}
    --site-background-size: {{ settings.background_zoom }}% auto;
    {%- else %}
    --site-background-size: {{ settings.background_fit }};
    {%- endif %}
    --site-background-position: {{ settings.background_position_x }}% {{ settings.background_position_y }}%;
    --site-background-repeat: {{ settings.background_repeat }};
    --site-background-attachment: {{ settings.background_attachment }};
    --color-foreground: var(--color-text);
    --style-border-radius-inputs: {{ settings.input_corner_radius }}px;
  }
  @media (max-width: 700px) {
    :root {
      --site-background-image: {{ bg_gradient }}, url({{ bg_url_small }});
    }
  }
  @media (min-width: 1700px), (min-width: 1000px) and (min-resolution: 1.5dppx) {
    :root {
      --site-background-image: {{ bg_gradient }}, url({{ bg_url_large }});
    }
  }
{% endstyle %}
