{% doc %}
  Placeholder garment silhouette for the clothing rack (shown before a collection is chosen).
  Drawn in a 200×260 box with the neckline at the top centre, so it lines up with the hanger.

  @param {number} index - Which garment to draw (cycles through 6 styles)
  @param {string} uid - Unique id prefix for the SVG gradient
{% enddoc %}

{% assign style = index | modulo: 6 %}
{% case style %}
  {% when 0 %}{% assign color = '#3d4250' %}
  {% when 1 %}{% assign color = '#1c1c1e' %}
  {% when 2 %}{% assign color = '#6e1f24' %}
  {% when 3 %}{% assign color = '#d9d2c3' %}
  {% when 4 %}{% assign color = '#2f4a3a' %}
  {% else %}{% assign color = '#9a6b3f' %}
{% endcase %}
{% assign grad = uid | append: '-' | append: index %}

<svg class="clothing-rack__placeholder" viewBox="0 0 200 260" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="{{ grad }}" x1="0" x2="1" y1="0" y2="0.3">
      <stop offset="0" style="stop-color: color-mix(in srgb, {{ color }}, white 16%)"/>
      <stop offset="0.45" style="stop-color: {{ color }}"/>
      <stop offset="1" style="stop-color: color-mix(in srgb, {{ color }}, black 38%)"/>
    </linearGradient>
  </defs>
  <g fill="url(#{{ grad }})" stroke="rgba(0,0,0,0.35)" stroke-width="1.2" stroke-linejoin="round">
    {% case style %}
      {% when 0 %}
        {% # Knit hoodie %}
        <path d="M76 16 L44 28 Q28 36 24 70 L12 206 L36 210 L52 100 L50 252 L150 252 L148 100 L164 210 L188 206 L176 70 Q172 36 156 28 L124 16 Z"/>
        <path d="M72 18 C70 58 130 58 128 18 C118 30 82 30 72 18 Z" fill="rgba(0,0,0,0.28)"/>
        <path d="M68 186 H132 L140 226 H60 Z" fill="rgba(0,0,0,0.12)"/>
        <g fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="3" stroke-dasharray="5 4">
          <path d="M72 60 V248 M88 64 V248 M104 66 V248 M120 64 V248 M136 60 V248"/>
        </g>
        <path d="M92 44 V88 M108 44 V92" fill="none" stroke="#cfc7b8" stroke-width="2"/>
      {% when 1 %}
        {% # Leather jacket %}
        <path d="M78 14 L42 26 Q26 34 22 72 L14 196 L38 200 L52 104 L50 222 L150 222 L148 104 L162 200 L186 196 L178 72 Q174 34 158 26 L122 14 Z"/>
        <path d="M78 14 L96 70 L86 110 L62 40 Z M122 14 L104 70 L114 110 L138 40 Z" fill="rgba(255,255,255,0.07)"/>
        <path d="M100 58 L108 222" fill="none" stroke="#9a9ea4" stroke-width="2" stroke-dasharray="2 2"/>
        <path d="M50 210 H150" fill="none" stroke="rgba(255,255,255,0.12)" stroke-width="6"/>
        <path d="M60 60 C70 110 58 160 64 200 M140 60 C130 110 142 160 136 200" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="2"/>
      {% when 2 %}
        {% # Chunky sweater %}
        <path d="M80 14 C88 24 112 24 120 14 L154 24 Q176 34 180 70 L190 214 L164 218 L150 100 L152 236 L48 236 L50 100 L36 218 L10 214 L20 70 Q24 34 46 24 Z"/>
        <path d="M80 14 C88 30 112 30 120 14" fill="none" stroke="rgba(0,0,0,0.4)" stroke-width="6"/>
        <path d="M48 226 H152 M12 206 L38 210 M188 206 L162 210" fill="none" stroke="rgba(0,0,0,0.3)" stroke-width="10"/>
        <g fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="4">
          <path d="M66 40 q6 10 0 20 q-6 10 0 20 q6 10 0 20 q-6 10 0 20 q6 10 0 20 q-6 10 0 20 q6 10 0 20 q-6 10 0 20 q6 10 0 20"/>
          <path d="M100 32 q6 10 0 20 q-6 10 0 20 q6 10 0 20 q-6 10 0 20 q6 10 0 20 q-6 10 0 20 q6 10 0 20 q-6 10 0 20 q6 10 0 20"/>
          <path d="M134 40 q6 10 0 20 q-6 10 0 20 q6 10 0 20 q-6 10 0 20 q6 10 0 20 q-6 10 0 20 q6 10 0 20 q-6 10 0 20 q6 10 0 20"/>
        </g>
      {% when 3 %}
        {% # Button-up shirt %}
        <path d="M80 14 L46 26 Q32 34 28 70 L20 200 L42 204 L54 96 L54 244 L146 244 L146 96 L158 204 L180 200 L172 70 Q168 34 154 26 L120 14 Z"/>
        <path d="M80 14 L100 34 L120 14 L112 10 L100 22 L88 10 Z" fill="rgba(0,0,0,0.1)"/>
        <path d="M100 34 V244" fill="none" stroke="rgba(0,0,0,0.2)"/>
        <g fill="rgba(0,0,0,0.35)" stroke="none">
          <circle cx="104" cy="56" r="2"/><circle cx="104" cy="96" r="2"/><circle cx="104" cy="136" r="2"/><circle cx="104" cy="176" r="2"/><circle cx="104" cy="216" r="2"/>
        </g>
        <path d="M62 62 H84 V80 H62 Z" fill="none" stroke="rgba(0,0,0,0.15)"/>
      {% when 4 %}
        {% # Slip dress %}
        <path d="M82 16 C90 28 110 28 118 16 L128 20 L126 74 Q150 150 176 252 Q100 262 24 252 Q50 150 74 74 L72 20 Z"/>
        <path d="M72 20 L78 4 M128 20 L122 4" fill="none" stroke="{{ color }}" stroke-width="3"/>
        <path d="M86 90 Q80 170 66 248 M114 90 Q120 170 134 248 M100 92 V252" fill="none" stroke="rgba(0,0,0,0.18)" stroke-width="2"/>
      {% else %}
        {% # Tee %}
        <path d="M78 14 C86 26 114 26 122 14 L158 26 L192 66 L166 88 L152 72 L152 236 L48 236 L48 72 L34 88 L8 66 L42 26 Z"/>
        <path d="M78 14 C86 28 114 28 122 14" fill="none" stroke="rgba(0,0,0,0.35)" stroke-width="4"/>
        <path d="M70 50 C76 110 66 170 72 232 M130 50 C124 110 134 170 128 232" fill="none" stroke="rgba(0,0,0,0.15)" stroke-width="2"/>
    {% endcase %}
  </g>
</svg>
