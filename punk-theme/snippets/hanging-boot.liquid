{% comment %}
  A boot hanging from a lace. It drops in from the top on load, then boot and lace swing together
  like a pendulum from the top of the lace (hanging-boot.js: load it once on any page that renders this).
  Renders a link when `href` is set, otherwise a submit button (for use inside a form).

  Accepts:
  - src: image URL of the boot
  - label: accessible name
  - href: optional link target
  - hook_x, hook_y: where the lace leaves the boot, % from the left / top edge of the image
  - delay: seconds before the drop starts
  - fixed: true keeps the boot on screen while the page scrolls, at fixed_x / fixed_y (% of the viewport width / height)
  - disabled: true blocks clicks
  - dim: true greys the boot out (use with `disabled`; leave off when the image is already a sold-out one)
  - stamp: optional text stamped across the boot (sold out)
  - hover_sway: optional strength (1 = default) of the push the mouse gives it; off when blank or 0
  - modifier: extra BEM modifier, e.g. 'back' or 'buy'

  Size, lace, sway and shadow come from CSS variables set by the parent
  (--boot-w, --boot-string, --boot-lace-color, --boot-lace-width, --boot-swing, --boot-shadow).
  Styles live in hanging-boot.css.
{% endcomment %}

{{ 'hanging-boot.css' | asset_url | stylesheet_tag }}
{{ 'stamp.css' | asset_url | stylesheet_tag }}

{% capture boot_inner %}
  <span class="hanging-boot__swing">
    <span class="hanging-boot__string" aria-hidden="true"></span>
    {% # theme-check-disable ImgWidthAndHeight, RemoteAsset %}
    <img class="hanging-boot__img" src="{{ src }}" alt="" loading="eager">
    {% # theme-check-enable ImgWidthAndHeight, RemoteAsset %}
    {% if stamp != blank %}
      <span class="hanging-boot__stamp stamp stamp--sold-out" aria-hidden="true">{{ stamp }}</span>
    {% endif %}
  </span>
{% endcapture %}

{% capture boot_style %}--boot-hook-x: {{ hook_x | default: 50 }}%; --boot-hook-y: {{ hook_y | default: 0 }}%; --boot-delay: {{ delay | default: 0 }}s{% if fixed %}; --boot-fixed-x: {{ fixed_x | default: 0 }}; --boot-fixed-y: {{ fixed_y | default: 0 }}{% endif %}{% endcapture %}

{% if href != blank %}
  <a
    class="hanging-boot{% if modifier != blank %} hanging-boot--{{ modifier }}{% endif %}{% if fixed %} hanging-boot--fixed{% endif %}"
    href="{{ href }}"
    aria-label="{{ label }}"
    style="{{ boot_style }}"
    {% if hover_sway > 0 %}data-hover-sway="{{ hover_sway }}"{% endif %}
  >
    {{ boot_inner }}
  </a>
{% else %}
  <button
    type="submit"
    class="hanging-boot{% if modifier != blank %} hanging-boot--{{ modifier }}{% endif %}{% if fixed %} hanging-boot--fixed{% endif %}{% if disabled %} hanging-boot--disabled{% endif %}{% if dim %} hanging-boot--dim{% endif %}"
    aria-label="{{ label }}"
    style="{{ boot_style }}"
    {% if hover_sway > 0 %}data-hover-sway="{{ hover_sway }}"{% endif %}
    {% if disabled %}disabled{% endif %}
  >
    {{ boot_inner }}
  </button>
{% endif %}
