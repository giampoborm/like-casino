{%- comment -%}
  Simple line icon for a social network, drawn in the current text colour.

  Accepts:
  - network: {String} instagram | tiktok | facebook | youtube | pinterest | x

  Usage:
  {% render 'social-icon', network: 'instagram' %}
{%- endcomment -%}
<svg class="social-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case network -%}
    {%- when 'instagram' -%}
      <rect x="3" y="3" width="18" height="18" rx="5"/>
      <circle cx="12" cy="12" r="4"/>
      <circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none"/>
    {%- when 'tiktok' -%}
      <path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5"/>
      <path d="M14 3c.4 2.8 2.2 4.6 5 5"/>
    {%- when 'facebook' -%}
      <rect x="3" y="3" width="18" height="18" rx="4"/>
      <path d="M15.5 7.5H14a2 2 0 0 0-2 2V21"/>
      <path d="M9 13h6"/>
    {%- when 'youtube' -%}
      <rect x="2.5" y="5.5" width="19" height="13" rx="4"/>
      <path d="M10 9.5v5l4.5-2.5z" fill="currentColor"/>
    {%- when 'pinterest' -%}
      <circle cx="12" cy="12" r="9"/>
      <path d="M11 9.5l-2.5 11"/>
      <path d="M9.6 14.5c3.4 1 6-1 6-4a3.6 3.6 0 0 0-7.2.3"/>
    {%- when 'x' -%}
      <path d="M4 4l16 16M20 4L4 20"/>
  {%- endcase -%}
</svg>
