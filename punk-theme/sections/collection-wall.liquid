{% comment %}
  Collection wall: each product is wrapped in a frame (bundled PNGs in assets/, or
  image pickers in the section settings). Frame choice, tilt, size and shadow are
  all editor settings. The title/price label beneath the frame stays straight.
{% endcomment %}

{%- liquid
  assign frame_labels = 'ornate|gilded|carved|rustic' | split: '|'
  assign frame_assets = 'frame1.png|frame2.png|frame3.png|frame4.png' | split: '|'
  assign tilt_pattern = '1,-2,3,-1,2,-3,1,3,-2,2' | split: ','
  assign cols = section.settings.columns
  assign shadow_alpha = section.settings.shadow_strength | divided_by: 100.0

  if section.settings.sold_out_text != blank
    assign sold_out_text = section.settings.sold_out_text
  else
    assign sold_out_text = 'products.sold_out' | t
  endif

  # How wide a card is drawn at each breakpoint of the stylesheet below, so the browser picks a
  # picture of that width (without it, it assumes the full screen width and downloads the largest)
  assign cols_lg = cols | at_most: 4
  assign cols_md = cols | at_most: 3
  assign cols_sm = cols | at_most: 2
  assign card_vw = 100 | divided_by: cols
  assign card_vw_lg = 100 | divided_by: cols_lg
  assign card_vw_md = 100 | divided_by: cols_md
  assign card_vw_sm = 100 | divided_by: cols_sm
  assign card_sizes = '(max-width: 520px) 100vw, (max-width: 720px) ' | append: card_vw_sm | append: 'vw, (max-width: 980px) ' | append: card_vw_md | append: 'vw, (max-width: 1200px) ' | append: card_vw_lg | append: 'vw, ' | append: card_vw | append: 'vw'
-%}

<section
  class="collection-wall"
  style="
    --wall-cols: {{ cols }};
    --wall-cols-lg: {{ cols | at_most: 4 }};
    --wall-cols-md: {{ cols | at_most: 3 }};
    --wall-cols-sm: {{ cols | at_most: 2 }};
    --wall-gap: {{ section.settings.gap }}px;
    --wall-aspect: {{ section.settings.aspect_ratio }};
    --wall-inset: {{ section.settings.frame_inset }}%;
    --wall-shadow-alpha: {{ shadow_alpha }};
  "
>
  {% if section.settings.show_sort %}
    <div class="collection-wall__toolbar">
      {% render 'collection-sort', collection: collection, prefix: 'collection-toolbar__sort' %}
    </div>
  {% endif %}

  {% paginate collection.products by section.settings.products_per_page %}
    <div class="collection-wall__grid">
      {% for product in collection.products %}
        {%- liquid
          assign frame_index = nil
          if section.settings.frame_style != 'auto' and section.settings.frame_style != 'none'
            for label in frame_labels
              if label == section.settings.frame_style
                assign frame_index = forloop.index0
              endif
            endfor
          elsif section.settings.frame_style == 'auto'
            assign frame_value = product.metafields.custom.frame.value | default: product.metafields.custom.frame | default: blank
            assign frame_key = frame_value | downcase | strip | replace: ' ', '-'
            for label in frame_labels
              if label == frame_key
                assign frame_index = forloop.index0
                break
              endif
            endfor
            if frame_index == nil
              assign frame_index = product.id | modulo: frame_assets.size
            endif
          endif

          assign frame_url = nil
          if frame_index != nil
            assign frame_picker = nil
            case frame_index
              when 0
                assign frame_picker = section.settings.frame_1
              when 1
                assign frame_picker = section.settings.frame_2
              when 2
                assign frame_picker = section.settings.frame_3
              when 3
                assign frame_picker = section.settings.frame_4
            endcase
            if frame_picker
              assign frame_url = frame_picker | image_url: width: 900
            else
              # Bundled frames are ~1000px wide; 700px covers a card at 2x
              assign frame_url = frame_assets[frame_index] | asset_img_url: '700x'
            endif
          endif

          assign tilt_i = forloop.index0 | modulo: 10
          assign tilt = tilt_pattern[tilt_i] | times: section.settings.tilt_max | divided_by: 3.0

          comment
            The first image is the transparent packshot used on the floor/rack, so the wall
            takes the second one — unless the product only has one image.
          endcomment
          assign wall_image = product.images[1] | default: product.featured_image

          # The first row is on screen when the page opens; the rest load as they scroll into view
          assign card_loading = 'lazy'
          assign card_priority = 'auto'
          if forloop.index <= cols
            assign card_loading = 'eager'
          endif
          if forloop.first
            assign card_priority = 'high'
          endif
          assign card_alt = wall_image.alt | default: product.title
        -%}

        <article class="collection-frame-card" style="--tilt: {{ tilt }}deg;">
          <div
            class="collection-frame-card__frame-wrapper{% if section.settings.straighten_on_hover %} collection-frame-card__frame-wrapper--straighten{% endif %}"
            style="{% if frame_url %}--frame-image: url({{ frame_url }});{% else %}--frame-inset: 0%;{% endif %}"
          >
            <a class="collection-frame-card__media" href="{{ product.url }}">
              {% if wall_image %}
                {{
                  wall_image
                  | image_url: width: 900
                  | image_tag:
                    loading: card_loading,
                    fetchpriority: card_priority,
                    widths: '200,300,400,600,800,900',
                    sizes: card_sizes,
                    class: 'collection-frame-card__img',
                    alt: card_alt
                }}
              {% else %}
                <div class="collection-frame-card__placeholder"></div>
              {% endif %}
              {% unless product.available %}
                <span class="collection-frame-card__sold-out">{{ sold_out_text | escape }}</span>
              {% endunless %}
            </a>
          </div>
          <div class="collection-frame-card__meta">
            <a class="collection-frame-card__title" href="{{ product.url }}">
              {{ product.title }}
            </a>
            {% if section.settings.show_price %}
              <span class="collection-frame-card__price">{{ product.price | money }}</span>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>

    <div class="collection-wall__pagination">
      {{ paginate | default_pagination }}
    </div>
  {% endpaginate %}
</section>

{% stylesheet %}
  .collection-wall {
    min-height: 100vh;
    padding: clamp(1rem, 2vw, 1.5rem) clamp(1.5rem, 4vw, 3rem) clamp(2.5rem, 5vw, 4rem);
    color: var(--color-text);
  }

  .collection-wall__toolbar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
  }

  .collection-toolbar__sort {
    display: flex;
    align-items: center;
  }

  .collection-toolbar__sort-btn {
    --btn-border-light: rgb(143, 143, 143);
    --btn-border-dark:  rgb(97, 97, 97);

    background: none;
    border-top:    2px solid var(--btn-border-light);
    border-left:   2px solid var(--btn-border-light);
    border-bottom: 2px solid var(--btn-border-dark);
    border-right:  2px solid var(--btn-border-dark);
    color: var(--color-text);
    padding: 0.4rem 1.1rem;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    font-family: var(--font-main--family);
    text-transform: uppercase;
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
    transition: background 0.15s, color 0.15s;
  }

  .collection-toolbar__sort-btn:hover,
  .collection-toolbar__sort-btn:focus {
    background: var(--color-text);
    color: var(--color-text-inverse);
    outline: none;
  }

  .collection-toolbar__sort-btn option {
    background: var(--color-text-inverse);
    color: var(--color-text);
    text-transform: none;
  }

  .collection-wall__grid {
    display: grid;
    grid-template-columns: repeat(var(--wall-cols, 5), minmax(0, 1fr));
    gap: var(--wall-gap, 32px);
    row-gap: calc(var(--wall-gap, 32px) * 1.4);
  }

  /* Article is the grid cell — never rotated */
  .collection-frame-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Only the frame+image wrapper rotates */
  .collection-frame-card__frame-wrapper {
    --frame-inset: var(--wall-inset, 12%);
    width: 100%;
    transform: rotate(var(--tilt, 0deg));
    filter: drop-shadow(0 10px 16px rgba(0, 0, 0, var(--wall-shadow-alpha, 0.45)));
    transition: transform 0.25s ease;
  }

  .collection-frame-card__frame-wrapper--straighten:hover {
    transform: rotate(0deg);
  }

  .collection-frame-card__media {
    position: relative;
    display: block;
    aspect-ratio: var(--wall-aspect, 3 / 4);
    background: transparent;
    overflow: hidden;
    border-radius: 6px;
    isolation: isolate;
  }

  .collection-frame-card__img {
    position: absolute;
    inset: var(--frame-inset);
    width: calc(100% - 2 * var(--frame-inset));
    height: calc(100% - 2 * var(--frame-inset));
    object-fit: cover;
    display: block;
  }

  .collection-frame-card__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--frame-image, none);
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    pointer-events: none;
    z-index: 2;
  }

  .collection-frame-card__placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.04));
  }

  .collection-frame-card__sold-out {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(-35deg);
    font-family: var(--font-stamp--family);
    color: var(--color-accent);
    font-size: clamp(1.75rem, 5vw, 5rem);
    text-transform: uppercase;
    z-index: 4;
    pointer-events: none;
    white-space: nowrap;
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.6);
    letter-spacing: 0.05em;
  }

  /* Meta label — always straight, never rotated */
  .collection-frame-card__meta {
    margin-top: 0.75rem;
    text-align: center;
    color: var(--color-text);
    text-shadow: var(--text-effect, none);
    width: 100%;
  }

  .collection-frame-card__title {
    display: block;
    color: inherit;
    text-decoration: none;
    letter-spacing: 0.05em;
    margin-bottom: 0.1rem;
  }

  .collection-frame-card__title:hover,
  .collection-frame-card__title:focus-visible {
    text-decoration: underline;
  }

  .collection-frame-card__price {
    font-size: 0.95rem;
  }

  .collection-wall__pagination {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    text-align: center;
  }

  @media (max-width: 1200px) {
    .collection-wall__grid {
      grid-template-columns: repeat(var(--wall-cols-lg, 4), minmax(0, 1fr));
    }
  }

  @media (max-width: 980px) {
    .collection-wall__grid {
      grid-template-columns: repeat(var(--wall-cols-md, 3), minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .collection-wall__grid {
      grid-template-columns: repeat(var(--wall-cols-sm, 2), minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .collection-wall__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .collection-frame-card__frame-wrapper {
      transform: rotate(calc(var(--tilt, 0deg) * 0.6));
    }

    .collection-frame-card__frame-wrapper--straighten:hover {
      transform: rotate(0deg);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection — Wall",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Columns (desktop)",
      "default": 5
    },
    {
      "type": "range",
      "id": "gap",
      "min": 12,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Space between pictures",
      "default": 32
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Picture shape",
      "options": [
        { "value": "3 / 4", "label": "Portrait 3:4" },
        { "value": "4 / 5", "label": "Portrait 4:5" },
        { "value": "2 / 3", "label": "Tall 2:3" },
        { "value": "1 / 1", "label": "Square" }
      ],
      "default": "3 / 4"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 40,
      "step": 4,
      "label": "Products per page",
      "default": 20
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show prices",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "Show sort menu",
      "default": true
    },
    {
      "type": "text",
      "id": "sold_out_text",
      "label": "Sold out text",
      "info": "Empty = default"
    },
    {
      "type": "header",
      "content": "Frames"
    },
    {
      "type": "select",
      "id": "frame_style",
      "label": "Frame",
      "info": "Auto = custom.frame metafield, else random",
      "options": [
        { "value": "auto", "label": "Auto (per product)" },
        { "value": "ornate", "label": "Ornate" },
        { "value": "gilded", "label": "Gilded" },
        { "value": "carved", "label": "Carved" },
        { "value": "rustic", "label": "Rustic" },
        { "value": "none", "label": "No frame" }
      ],
      "default": "auto"
    },
    {
      "type": "range",
      "id": "frame_inset",
      "min": 0,
      "max": 25,
      "step": 1,
      "unit": "%",
      "label": "Frame thickness",
      "default": 12
    },
    {
      "type": "image_picker",
      "id": "frame_1",
      "label": "Ornate frame image",
      "info": "Empty = default"
    },
    {
      "type": "image_picker",
      "id": "frame_2",
      "label": "Gilded frame image",
      "info": "Empty = default"
    },
    {
      "type": "image_picker",
      "id": "frame_3",
      "label": "Carved frame image",
      "info": "Empty = default"
    },
    {
      "type": "image_picker",
      "id": "frame_4",
      "label": "Rustic frame image",
      "info": "Empty = default"
    },
    {
      "type": "header",
      "content": "Tilt and shadow"
    },
    {
      "type": "range",
      "id": "tilt_max",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "°",
      "label": "Maximum tilt",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "straighten_on_hover",
      "label": "Straighten on hover",
      "default": false
    },
    {
      "type": "range",
      "id": "shadow_strength",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Shadow strength",
      "default": 45
    }
  ],
  "presets": [
    {
      "name": "Collection — Wall"
    }
  ]
}
{% endschema %}
