{%- capture header_logo -%}
  <a class="header__logo-link" href="{{ routes.root_url }}">
    {%- if section.settings.logo_style == 'custom' and section.settings.custom_logo != blank -%}
      {%- liquid
        assign custom_logo = section.settings.custom_logo
        assign logo_h1 = section.settings.logo_height
        assign logo_h2 = logo_h1 | times: 2
        assign logo_h3 = logo_h1 | times: 3
        assign logo_w = custom_logo.aspect_ratio | times: logo_h2 | round
      -%}
      <img
        src="{{ custom_logo | image_url: height: logo_h2 }}"
        srcset="
          {{ custom_logo | image_url: height: logo_h1 }} 1x,
          {{ custom_logo | image_url: height: logo_h2 }} 2x,
          {{ custom_logo | image_url: height: logo_h3 }} 3x
        "
        alt="{{ custom_logo.alt | default: shop.name | escape }}"
        class="header__logo header__logo--custom"
        width="{{ logo_w }}"
        height="{{ logo_h2 }}"
        loading="eager"
      >
    {%- elsif section.settings.logo_style == 'sign' -%}
      <img
        src="{{ 'logosign-header.png' | asset_url }}"
        alt="{{ shop.name }}"
        class="header__logo header__logo--sign"
        width="960"
        height="291"
        loading="eager"
      >
    {%- else -%}
      <img
        src="{{ 'minilogo.png' | asset_url }}"
        alt="{{ shop.name }}"
        class="header__logo header__logo--mini"
        width="149"
        height="192"
        loading="eager"
      >
    {%- endif -%}
  </a>
{%- endcapture -%}

{%- comment -%}
  The cart icon is a sprite strip of equal frames, from empty to full: object-fit cover makes one
  frame fill the box and object-position picks which. Frame 1 is the empty cart; the settings say
  which frame shows 1, 2 and 3+ items. On an add, header-cart.js steps from the current frame to
  the next level's, through the frames in between (clothes falling in). Each frame has empty space
  above the basket for the fall, and the icon's top edge sits on the top of the screen, so the
  clothes come in from the screen edge. Bundled strip: 17 frames of 180×280, levels at 7 / 12 / 17.
{%- endcomment -%}
{%- liquid
  assign cart_frames = section.settings.cart_sprite_frames | default: 17
  assign cart_frame_1 = section.settings.cart_frame_1 | default: 7 | at_most: cart_frames
  assign cart_frame_2 = section.settings.cart_frame_2 | default: 12 | at_most: cart_frames
  assign cart_frame_3 = section.settings.cart_frame_3 | default: 17 | at_most: cart_frames
  if section.settings.cart_sprite != blank
    assign cart_sprite = section.settings.cart_sprite | image_url: width: 5760
    assign cart_frame_w = section.settings.cart_sprite.width | divided_by: cart_frames
    assign cart_frame_h = section.settings.cart_sprite.height
  else
    # Bundled strip, served at 2295px (17 frames of exactly 135x210px, over twice the 60px it is
    # drawn at) instead of the 3060px file
    assign cart_sprite = 'cart-fill-sprite.png' | asset_img_url: '2295x'
    assign cart_frame_w = 180
    assign cart_frame_h = 280
  endif
  case cart.item_count
    when 0
      assign cart_frame = 1
    when 1
      assign cart_frame = cart_frame_1
    when 2
      assign cart_frame = cart_frame_2
    else
      assign cart_frame = cart_frame_3
  endcase
  assign cart_steps = cart_frames | minus: 1
  assign cart_frame_pos = cart_frame | minus: 1 | times: 100.0 | divided_by: cart_steps
  if cart.item_count == 1
    assign cart_item_word = 'cart.item_singular' | t
  else
    assign cart_item_word = 'cart.item_plural' | t
  endif
-%}
{%- capture header_cart -%}
  <a
    href="{{ routes.cart_url }}"
    class="header__cart-link"
    data-frames="{{ cart_frames }}"
    data-levels="1,{{ cart_frame_1 }},{{ cart_frame_2 }},{{ cart_frame_3 }}"
    data-count="{{ cart.item_count }}"
    data-frame-ms="{{ section.settings.cart_frame_ms | default: 90 }}"
    data-label="{{ 'cart.title' | t }}"
    data-item-one="{{ 'cart.item_singular' | t }}"
    data-item-many="{{ 'cart.item_plural' | t }}"
  >
    {% # theme-check-disable RemoteAsset %}
    <img
      src="{{ cart_sprite }}"
      alt="{{ 'cart.title' | t }}{% if cart.item_count > 0 %} ({{ cart.item_count }} {{ cart_item_word }}){% endif %}"
      class="header__cart-icon"
      style="aspect-ratio: {{ cart_frame_w }} / {{ cart_frame_h }}; object-position: {{ cart_frame_pos }}% 0"
      width="{{ cart_frame_w }}"
      height="{{ cart_frame_h }}"
    >
    {% # theme-check-enable RemoteAsset %}
  </a>
{%- endcapture -%}

{%- assign shadow_color = section.settings.shadow_color -%}
{%- assign shadow_alpha = section.settings.shadow_opacity | divided_by: 100.0 -%}
<header
  class="header{% unless section.settings.icon_effect == 'none' %} header--{{ section.settings.icon_effect }}{% endunless %}"
  style="
    --header-logo-height: {{ section.settings.logo_height }}px;
    --header-shadow-x: {{ section.settings.shadow_x }}px;
    --header-shadow-y: {{ section.settings.shadow_y }}px;
    --header-shadow-blur: {{ section.settings.shadow_blur }}px;
    --header-shadow-lift: {{ section.settings.shadow_lift }}px;
    --header-shadow-color: rgba({{ shadow_color.red }}, {{ shadow_color.green }}, {{ shadow_color.blue }}, {{ shadow_alpha }});
    --header-cart-y: {{ section.settings.cart_offset_y | default: -10 }}px;
  "
>
  {%- assign header_positions = 'left,center,right' | split: ',' -%}
  {%- for position in header_positions -%}
    <div class="header__slot header__slot--{{ position }}">
      {%- if section.settings.logo_position == position -%}
        {{ header_logo }}
      {%- endif -%}
      {%- if section.settings.cart_position == position -%}
        {{ header_cart }}
      {%- endif -%}
    </div>
  {%- endfor -%}
</header>
<script src="{{ 'header-cart.js' | asset_url }}" defer></script>

{% stylesheet %}
  .header {
    display: grid;
    /* side columns share the leftover space equally so the centre slot stays truly centred */
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    column-gap: 1rem;
    padding: 0 1.5rem 1rem;
  }
  /* Slots fill the row's height so the cart can sit at its top (the logo stays centred) */
  .header__slot {
    align-self: stretch;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-width: 0;
  }
  .header__slot--left {
    justify-content: flex-start;
  }
  .header__slot--center {
    justify-content: center;
  }
  .header__slot--right {
    justify-content: flex-end;
  }
  .header a {
    position: relative;
    text-decoration: none;
    color: var(--color-foreground);
  }
  .header__logo-link {
    display: flex;
    min-width: 0;
  }
  .header__logo {
    display: block;
    height: var(--header-logo-height, 80px);
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }
  .header__logo--mini {
    margin-top: 15px;
  }
  .header__logo--sign,
  .header__logo--custom {
    margin-top: 10px;
  }
  /* Top of the header = top of the screen: the empty space above the basket is where clothes fall from */
  .header__cart-link {
    position: relative;
    flex-shrink: 0;
    align-self: flex-start;
    /* Up (negative) pushes the empty top of the frame past the screen edge; the clothes still enter from it */
    margin-top: var(--header-cart-y, -10px);
  }
  /* Sprite strip: aspect-ratio (inline) is one frame, so cover shows exactly one; object-position picks it. */
  .header__cart-icon {
    display: block;
    width: 60px;
    height: auto;
    object-fit: cover;
  }
  /* glow: logo + cart; brightens on hover */
  .header--glow .header__logo,
  .header--glow .header__cart-icon {
    filter: drop-shadow(0 0 6px rgba(255, 255, 255, 0.7));
    transition: filter 0.25s ease;
  }
  .header--glow .header__logo-link:hover .header__logo,
  .header--glow .header__cart-link:hover .header__cart-icon {
    filter: drop-shadow(0 0 14px rgba(255, 255, 255, 1)) drop-shadow(0 0 28px rgba(255, 255, 255, 0.5));
  }
  /* drop shadow: logo + cart; on hover the image lifts and the shadow grows by the same amount */
  .header--shadow .header__logo,
  .header--shadow .header__cart-icon {
    filter: drop-shadow(var(--header-shadow-x) var(--header-shadow-y) var(--header-shadow-blur) var(--header-shadow-color));
    transition: filter 0.2s ease, transform 0.2s ease;
  }
  .header--shadow .header__logo-link:hover .header__logo,
  .header--shadow .header__cart-link:hover .header__cart-icon {
    transform: translate(calc(var(--header-shadow-lift) * -1), calc(var(--header-shadow-lift) * -1));
    filter: drop-shadow(
      calc(var(--header-shadow-x) + var(--header-shadow-lift))
      calc(var(--header-shadow-y) + var(--header-shadow-lift))
      var(--header-shadow-blur)
      var(--header-shadow-color)
    );
  }
  @media (max-width: 600px) {
    .header {
      padding: 0 1rem 0.75rem;
    }
    .header__logo {
      height: min(var(--header-logo-height, 80px), 5rem);
    }
    .header__logo--sign,
    .header__logo--custom {
      max-width: 60vw;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "select",
      "id": "logo_style",
      "label": "Logo",
      "options": [
        { "value": "mini", "label": "Mini logo" },
        { "value": "sign", "label": "Hollywood sign" },
        { "value": "custom", "label": "Custom upload" }
      ],
      "default": "mini"
    },
    {
      "type": "image_picker",
      "id": "custom_logo",
      "label": "Custom logo",
      "info": "Transparent PNG, 420px+ tall",
      "visible_if": "{{ section.settings.logo_style == 'custom' }}"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height",
      "min": 40,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "select",
      "id": "logo_position",
      "label": "Logo position",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" },
        { "value": "right", "label": "t:options.alignment.right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "t:general.cart"
    },
    {
      "type": "select",
      "id": "cart_position",
      "label": "Cart position",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" },
        { "value": "right", "label": "t:options.alignment.right" }
      ],
      "default": "right"
    },
    {
      "type": "range",
      "id": "cart_frame_ms",
      "label": "Fill animation speed",
      "info": "Time per frame. Lower = faster",
      "min": 40,
      "max": 300,
      "step": 10,
      "unit": "ms",
      "default": 90
    },
    {
      "type": "range",
      "id": "cart_offset_y",
      "label": "Cart position up/down",
      "info": "Negative = up",
      "min": -40,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": -10
    },
    {
      "type": "header",
      "content": "Logo & cart effect"
    },
    {
      "type": "select",
      "id": "icon_effect",
      "label": "Effect",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "glow", "label": "White glow" },
        { "value": "shadow", "label": "Drop shadow" }
      ],
      "default": "glow"
    },
    {
      "type": "color",
      "id": "shadow_color",
      "label": "Shadow color",
      "default": "#000000",
      "visible_if": "{{ section.settings.icon_effect == 'shadow' }}"
    },
    {
      "type": "range",
      "id": "shadow_opacity",
      "label": "Shadow opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 60,
      "visible_if": "{{ section.settings.icon_effect == 'shadow' }}"
    },
    {
      "type": "range",
      "id": "shadow_x",
      "label": "Horizontal offset",
      "min": -20,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 3,
      "visible_if": "{{ section.settings.icon_effect == 'shadow' }}"
    },
    {
      "type": "range",
      "id": "shadow_y",
      "label": "Vertical offset",
      "min": -20,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 3,
      "visible_if": "{{ section.settings.icon_effect == 'shadow' }}"
    },
    {
      "type": "range",
      "id": "shadow_blur",
      "label": "Blur",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ section.settings.icon_effect == 'shadow' }}"
    },
    {
      "type": "range",
      "id": "shadow_lift",
      "label": "Hover lift",
      "visible_if": "{{ section.settings.icon_effect == 'shadow' }}",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "header",
      "content": "Cart sprite"
    },
    {
      "type": "paragraph",
      "content": "The numbers below are set for the bundled basket. Change them only if you upload your own sprite."
    },
    {
      "type": "image_picker",
      "id": "cart_sprite",
      "label": "Cart sprite",
      "info": "One horizontal strip of equal frames (180×280px each), empty cart first. Empty = bundled basket"
    },
    {
      "type": "range",
      "id": "cart_sprite_frames",
      "label": "Frames in the strip",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 17
    },
    {
      "type": "range",
      "id": "cart_frame_1",
      "label": "Frame for 1 item",
      "min": 1,
      "max": 24,
      "step": 1,
      "default": 7
    },
    {
      "type": "range",
      "id": "cart_frame_2",
      "label": "Frame for 2 items",
      "min": 1,
      "max": 24,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "cart_frame_3",
      "label": "Frame for 3+ items",
      "min": 1,
      "max": 24,
      "step": 1,
      "default": 17
    }
  ]
}
{% endschema %}
