{% comment %}
  Collection floor: products appear as clothes scattered on a floor.
  Overrides the body background to floorproducts.png via an injected <style> tag.
{% endcomment %}

<style>
  body,
  body.theme-wall-bg {
    background-image: url({{ 'floorproducts.png' | asset_url }});
    background-size: 100% auto;
    background-position: center top;
    background-repeat: repeat-y;
    background-attachment: scroll;
    background-color: #c8b89a;
  }
</style>

<section class="collection-floor">
  <div class="collection-floor__toolbar">
    {% render 'collection-sort', collection: collection, prefix: 'collection-floor__sort', show_label: true %}
  </div>

  {% assign mb_offsets = '16,32,8,40,20,12,36,24,44,10' | split: ',' %}
  {% assign x_offsets = '0,8,-10,14,-6,12,-14,6,-8,10' | split: ',' %}
  {% assign rot_offsets = '1,-2,3,-1,2,-3,1,3,-2,2' | split: ',' %}

  {% paginate collection.products by 20 %}
    <div class="collection-floor__scene">
    <div class="collection-floor__grid">
      {% for product in collection.products %}
        {% assign offset_index = forloop.index0 | modulo: 10 %}
        {% assign mb_off = mb_offsets[offset_index] %}
        {% assign x_off = x_offsets[offset_index] %}
        {% assign rot_off = rot_offsets[offset_index] %}
        <article class="collection-floor-card" style="margin-bottom: {{ mb_off }}px; --x-off: {{ x_off }}px;">
          <a class="collection-floor-card__media" href="{{ product.url }}" style="--rot: {{ rot_off }}deg;">
            {% if product.featured_image %}
              {{
                product.featured_image
                | image_url: width: 900
                | image_tag:
                  loading: 'lazy',
                  widths: '400,600,800,900',
                  class: 'collection-floor-card__img',
                  alt: product.featured_image.alt | default: product.title
              }}
            {% else %}
              <div class="collection-floor-card__placeholder"></div>
            {% endif %}
            {% unless product.available %}
              <span class="collection-floor-card__sold-out">Sold Out</span>
            {% endunless %}
          </a>
          <div class="collection-floor-card__meta">
            <a class="collection-floor-card__title" href="{{ product.url }}">{{ product.title }}</a>
            <span class="collection-floor-card__price">{{ product.price | money }}</span>
          </div>
        </article>
      {% endfor %}
    </div>
    </div>

    <div class="collection-floor__pagination">
      {{ paginate | default_pagination }}
    </div>
  {% endpaginate %}
</section>

{% stylesheet %}
  .collection-floor {
    min-height: 100vh;
    padding: clamp(1rem, 2vw, 1.5rem) clamp(1.5rem, 4vw, 3rem) clamp(2.5rem, 5vw, 4rem);
    background: transparent;
    color: #1a1008;
  }

  .collection-floor__toolbar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    background: transparent;
    padding: 0.25rem 0;
  }

  .collection-floor__sort {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .collection-floor__sort-label {
    font-family: 'TypewriterCustom', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(244, 237, 226, 0.6);
  }

  .collection-floor__sort-btn {
    --btn-border-light: rgb(143, 143, 143);
    --btn-border-dark:  rgb(97, 97, 97);

    background: none;
    border-top:    2px solid var(--btn-border-light);
    border-left:   2px solid var(--btn-border-light);
    border-bottom: 2px solid var(--btn-border-dark);
    border-right:  2px solid var(--btn-border-dark);
    color: #fff;
    padding: 0.4rem 0.8rem 0.4rem 0.2rem;
    text-transform: uppercase;
    font-size: 0.65rem;
    font-family: 'TypewriterCustom', monospace;
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
    transition: background 0.15s, color 0.15s;
  }

  .collection-floor__sort-btn:hover,
  .collection-floor__sort-btn:focus {
    background: #fff;
    color: #000;
    outline: none;
  }

  .collection-floor__sort-btn option {
    background: #1a1008;
    color: #f4ede2;
  }

  .collection-floor__scene {
    perspective: 1400px;
    perspective-origin: 50% -10%;
  }

  .collection-floor__grid {
    column-count: 4;
    column-gap: clamp(1rem, 2.5vw, 2rem);
    /* transform: rotateX(10deg);
    transform-origin: top center; */
  }

  .collection-floor-card {
    display: inline-block;
    width: 100%;
    break-inside: avoid;
    margin-bottom: clamp(1rem, 2vw, 1.75rem);
    transform: translateX(var(--x-off, 0px));
    filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.3));
    transition: filter 0.2s ease;
  }

  .collection-floor-card:hover {
    filter: drop-shadow(0 2px 2px rgba(0, 0, 0, 0.3)) drop-shadow(0 3px 6px rgba(0, 0, 0, 0.5)) drop-shadow(0 0 18px rgba(255, 255, 255, 0.75));
  }

  .collection-floor-card__media {
    display: block;
    width: 100%;
    position: relative;
  }

  .collection-floor-card__sold-out {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(-35deg);
    font-family: 'OctinSpraypaint', sans-serif;
    color: #cc0000;
    font-size: clamp(2rem, 10vw, 5rem);
    text-transform: uppercase;
    z-index: 3;
    pointer-events: none;
    white-space: nowrap;
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.6);
    letter-spacing: 0.05em;
  }

  .collection-floor-card__img {
    width: 100%;
    height: auto;
    display: block;
    transform: rotate(var(--rot, 0deg));
    transform-origin: center bottom;
  }

  .collection-floor-card__placeholder {
    width: 100%;
    height: 100%;
    background: rgba(26, 16, 8, 0.08);
  }

  .collection-floor-card__meta {
    margin-top: 1.2rem;
    text-align: center;
    font-family: 'TypewriterCustom', monospace;
    color: #f4ede2;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.85), 0 1px 3px rgba(0, 0, 0, 0.6);
    width: 100%;
  }

  .collection-floor-card__title {
    display: block;
    color: inherit;
    text-decoration: none;
    letter-spacing: 0.05em;
    font-size: 0.88rem;
    margin-bottom: 0.1rem;
  }

  .collection-floor-card__title:hover,
  .collection-floor-card__title:focus-visible {
    text-decoration: underline;
  }

  .collection-floor-card__price {
    font-size: 0.85rem;
    opacity: 0.75;
  }

  .collection-floor__pagination {
    margin-top: clamp(2rem, 4vw, 3rem);
    text-align: center;
  }

  @media (max-width: 980px) {
    .collection-floor__grid { column-count: 3; }
  }
  @media (max-width: 720px) {
    .collection-floor__grid { column-count: 2; }
  }
  @media (max-width: 520px) {
    .collection-floor__grid { column-count: 2; }
    .collection-floor { padding-left: 0; padding-right: 0; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection — Floor",
  "settings": [],
  "presets": [
    {
      "name": "Collection — Floor"
    }
  ]
}
{% endschema %}
