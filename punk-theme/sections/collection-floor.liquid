{% comment %}
  Collection floor: products appear as clothes scattered on a floor.
  Sits on the global site background (Theme settings → Site background).
{% endcomment %}

{%- liquid
  assign mb_offsets = '16,32,8,40,20,12,36,24,44,10' | split: ','
  assign x_offsets = '0,8,-10,14,-6,12,-14,6,-8,10' | split: ','
  assign rot_offsets = '1,-2,3,-1,2,-3,1,3,-2,2' | split: ','

  assign row_scale = section.settings.row_spacing | divided_by: 100.0
  assign x_scale = section.settings.offset | divided_by: 100.0
  assign rot_scale = section.settings.tilt | divided_by: 100.0

  if section.settings.sold_out_text != blank
    assign sold_out_text = section.settings.sold_out_text
  else
    assign sold_out_text = 'products.sold_out' | t
  endif

  assign cols = section.settings.columns
-%}

<section
  class="collection-floor"
  style="
    --floor-cols: {{ cols }};
    --floor-cols-md: {{ cols | at_most: 3 }};
    --floor-cols-sm: {{ section.settings.columns_mobile }};
    --floor-gap: {{ section.settings.gap }}px;
    --floor-shadow: {{ section.settings.shadow_strength | divided_by: 100.0 }};
    --floor-glow: {{ section.settings.glow_strength | divided_by: 100.0 }};
    --floor-sold-out-size: {{ section.settings.sold_out_size }}px;
    --floor-sold-out-angle: {{ section.settings.sold_out_angle }}deg;
    --floor-sold-out-shadow: {{ section.settings.sold_out_shadow | divided_by: 100.0 }};
  "
>
  {% if section.settings.show_sort %}
    <div class="collection-floor__toolbar">
      {% render 'collection-sort', collection: collection, prefix: 'collection-floor__sort', show_label: true %}
    </div>
  {% endif %}

  {% paginate collection.products by section.settings.products_per_page %}
    <div class="collection-floor__grid">
      {% for product in collection.products %}
        {%- liquid
          assign offset_index = forloop.index0 | modulo: 10
          assign mb_off = mb_offsets[offset_index] | times: row_scale
          assign x_off = x_offsets[offset_index] | times: x_scale
          assign rot_off = rot_offsets[offset_index] | times: rot_scale
        -%}
        <article class="collection-floor-card" style="margin-bottom: {{ mb_off }}px; --x-off: {{ x_off }}px;">
          <a class="collection-floor-card__media" href="{{ product.url }}" style="--rot: {{ rot_off }}deg;">
            {% if product.featured_image %}
              {{
                product.featured_image
                | image_url: width: 900
                | image_tag:
                  loading: 'lazy',
                  widths: '400,600,800,900',
                  class: 'collection-floor-card__img',
                  alt: product.featured_image.alt | default: product.title
              }}
            {% else %}
              <div class="collection-floor-card__placeholder"></div>
            {% endif %}
            {% unless product.available %}
              <span class="collection-floor-card__sold-out">{{ sold_out_text | escape }}</span>
            {% endunless %}
          </a>
          {% if section.settings.show_title or section.settings.show_price %}
            <div class="collection-floor-card__meta">
              {% if section.settings.show_title %}
                <a class="collection-floor-card__title" href="{{ product.url }}">{{ product.title }}</a>
              {% endif %}
              {% if section.settings.show_price %}
                <span class="collection-floor-card__price">{{ product.price | money }}</span>
              {% endif %}
            </div>
          {% endif %}
        </article>
      {% endfor %}
    </div>

    <div class="collection-floor__pagination">
      {{ paginate | default_pagination }}
    </div>
  {% endpaginate %}
</section>

{% stylesheet %}
  .collection-floor {
    min-height: 100vh;
    padding: clamp(1rem, 2vw, 1.5rem) clamp(1.5rem, 4vw, 3rem) clamp(2.5rem, 5vw, 4rem);
    background: transparent;
    color: var(--color-text);
  }

  .collection-floor__toolbar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    background: transparent;
    padding: 0.25rem 0;
  }

  .collection-floor__sort {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .collection-floor__sort-label {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  .collection-floor__sort-btn {
    --btn-border-light: rgb(143, 143, 143);
    --btn-border-dark:  rgb(97, 97, 97);

    background: none;
    border-top:    2px solid var(--btn-border-light);
    border-left:   2px solid var(--btn-border-light);
    border-bottom: 2px solid var(--btn-border-dark);
    border-right:  2px solid var(--btn-border-dark);
    color: var(--color-text);
    padding: 0.4rem 0.8rem 0.4rem 0.2rem;
    text-transform: uppercase;
    font-size: 0.65rem;
    font-family: var(--font-main--family);
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
    transition: background 0.15s, color 0.15s;
  }

  .collection-floor__sort-btn:hover,
  .collection-floor__sort-btn:focus {
    background: var(--color-text);
    color: var(--color-text-inverse);
    outline: none;
  }

  .collection-floor__sort-btn option {
    background: var(--color-text-inverse);
    color: var(--color-text);
  }

  .collection-floor__grid {
    column-count: var(--floor-cols);
    column-gap: var(--floor-gap);
  }

  .collection-floor-card {
    display: inline-block;
    width: 100%;
    break-inside: avoid;
    transform: translateX(var(--x-off, 0px));
    filter: drop-shadow(0 4px 8px rgba(0, 0, 0, var(--floor-shadow)));
    transition: filter 0.2s ease;
  }

  .collection-floor-card:hover {
    filter:
      drop-shadow(0 3px 6px rgba(0, 0, 0, calc(var(--floor-shadow) * 1.6)))
      drop-shadow(0 0 18px rgba(255, 255, 255, var(--floor-glow)));
  }

  .collection-floor-card__media {
    display: block;
    width: 100%;
    position: relative;
  }

  .collection-floor-card__sold-out {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(var(--floor-sold-out-angle));
    font-family: var(--font-stamp--family);
    color: var(--color-accent);
    font-size: clamp(2rem, 10vw, var(--floor-sold-out-size));
    text-transform: uppercase;
    z-index: 3;
    pointer-events: none;
    white-space: nowrap;
    text-shadow: 1px 1px 0 rgba(0, 0, 0, var(--floor-sold-out-shadow));
    letter-spacing: 0.05em;
  }

  .collection-floor-card__img {
    width: 100%;
    height: auto;
    display: block;
    transform: rotate(var(--rot, 0deg));
    transform-origin: center bottom;
  }

  .collection-floor-card__placeholder {
    width: 100%;
    height: 100%;
    background: rgba(26, 16, 8, 0.08);
  }

  .collection-floor-card__meta {
    margin-top: 1.2rem;
    text-align: center;
    color: var(--color-text);
    text-shadow: var(--text-effect, none);
    width: 100%;
  }

  .collection-floor-card__title {
    display: block;
    color: inherit;
    text-decoration: none;
    letter-spacing: 0.05em;
    font-size: 0.88rem;
    margin-bottom: 0.1rem;
  }

  .collection-floor-card__title:hover,
  .collection-floor-card__title:focus-visible {
    text-decoration: underline;
  }

  .collection-floor-card__price {
    font-size: 0.85rem;
    opacity: 0.75;
  }

  .collection-floor__pagination {
    margin-top: clamp(2rem, 4vw, 3rem);
    text-align: center;
  }

  @media (max-width: 980px) {
    .collection-floor__grid { column-count: var(--floor-cols-md); }
  }
  @media (max-width: 720px) {
    .collection-floor__grid { column-count: var(--floor-cols-sm); }
  }
  @media (max-width: 520px) {
    .collection-floor { padding-left: 0; padding-right: 0; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection — Floor",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Columns",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "label": "Columns on mobile",
      "default": 2
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Column gap",
      "default": 32
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 4,
      "max": 48,
      "step": 1,
      "label": "Products per page",
      "default": 20
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "Show sort menu",
      "default": true
    },
    {
      "type": "header",
      "content": "Scatter"
    },
    {
      "type": "range",
      "id": "tilt",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "%",
      "label": "Tilt",
      "default": 100
    },
    {
      "type": "range",
      "id": "offset",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "%",
      "label": "Sideways offset",
      "default": 100
    },
    {
      "type": "range",
      "id": "row_spacing",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "%",
      "label": "Row spacing",
      "default": 100
    },
    {
      "type": "header",
      "content": "Product text"
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show names",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show prices",
      "default": true
    },
    {
      "type": "text",
      "id": "sold_out_text",
      "label": "Sold out text",
      "info": "Empty = default"
    },
    {
      "type": "range",
      "id": "sold_out_size",
      "min": 24,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Sold out size",
      "default": 80
    },
    {
      "type": "range",
      "id": "sold_out_angle",
      "min": -90,
      "max": 90,
      "step": 5,
      "unit": "°",
      "label": "Sold out angle",
      "default": -35
    },
    {
      "type": "range",
      "id": "sold_out_shadow",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Sold out shadow",
      "default": 60
    },
    {
      "type": "header",
      "content": "Shadows"
    },
    {
      "type": "range",
      "id": "shadow_strength",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Shadow",
      "default": 30
    },
    {
      "type": "range",
      "id": "glow_strength",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Hover glow",
      "default": 75
    }
  ],
  "presets": [
    {
      "name": "Collection — Floor"
    }
  ]
}
{% endschema %}
