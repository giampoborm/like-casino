{% comment %}
  Clothing rack: products hang from a rail that runs across the full width of the screen; scrolling
  slides the garments along it, so they come in from the sides like on a real rail.
  - Flat, 2D look on top of the site-wide background (no wall/floor of its own).
  - Every rack part is a PNG the client can swap in the editor: a rail tile (repeats across) and a
    hanger with its hook. The bundled rack-*.png files are placeholders/fallbacks.
  - Garment image per product: the `custom.rack_image` metafield if set (a PNG of the garment on a
    hook-less hanger; our hook is added on top of it), otherwise the featured image on the hanger PNG.
  - The rail always snaps to a product (mouse wheel, drag, touch, keyboard); the product in the middle
    is the selected one, and its name + price show under the rack.
  - Uses `limit` (max 24) instead of `paginate`, like catalogue-rows: a rack is a teaser, and the last
    hanger links to the full, paginated collection page.

  PNG templates (draw over the placeholders to keep the alignment):
  - tube.png (rail)  2456×46, tiles horizontally; the pipe fills the full height (46px next to a 400px hanger).
  - hook.png         130×116; drawn in front of the rail. The middle of its bowl (100, 31) sits on the centre
                     of the pipe, the bottom of its stem (x 104.5) goes into the hanger's neck.
  - rack-hanger-body.png  400×160, the hanger without its hook; the neck's top is at y 68, the stem's axis at x 199.5.
                     Hook and hanger share one scale: 1 hanger px = garment width × 0.8 / 400.
  - rack image (custom.rack_image): the garment on a hook-less hanger, transparent PNG, no cast shadow. The
                     top edge of the image touches the top of the hanger's neck and the neck is centred
                     horizontally (see rack-placeholder-hookless.png, 500×662). Shot at one camera distance
                     for every product; it is drawn at its pixel size × (garment width × 0.8 / 400) / the
                     "Rack image size" setting, so a garment keeps its real size next to the others.
{% endcomment %}

{{ 'section-clothing-rack.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-clothing-rack.js' | asset_url }}" defer></script>

{% liquid
  # No collection picked: the collection being viewed (on a collection template), else all products
  assign rack_collection = section.settings.collection
  if rack_collection == blank
    assign rack_collection = collection | default: collections.all
  endif

  # Wide garment shots can hang up to 1.9 garments wide (see the CSS), so request images for that
  assign widest = section.settings.garment_width | times: 1.9 | round
  assign image_sizes = '(max-width: 720px) 80vw, ' | append: widest | append: 'px'

  # Set by the first product that makes it onto the rack (name + price shown under it)
  assign first_title = blank

  # Tallest rack image (source px), so the stage is tall enough and no garment is cut off at the bottom
  assign max_rack_h = 0
  for product in rack_collection.products limit: section.settings.limit
    assign rack_h = product.metafields.custom.rack_image.value.height
    if rack_h > max_rack_h
      assign max_rack_h = rack_h
    endif
  endfor
  if section.settings.preview_hung
    assign placeholder_h = section.settings.rack_image_scale | times: 662
    if placeholder_h > max_rack_h
      assign max_rack_h = placeholder_h
    endif
  endif

  if section.settings.rail_image != blank
    assign rail_url = section.settings.rail_image | image_url: height: 88
  else
    assign rail_url = 'tube.png' | asset_url
  endif
%}

{% comment %}
  Hook + hanger body, repeated on every hanger (same URLs, so they download once). Both are drawn in
  front of the rail: the hook wraps the pipe and its stem goes into the hanger's neck.
{% endcomment %}
{% capture hook_img %}
  {% if section.settings.hook_image != blank %}
    {{ section.settings.hook_image | image_url: width: 260 | image_tag: class: 'clothing-rack__hook', alt: '', loading: 'lazy', draggable: 'false' }}
  {% else %}
    {% # theme-check-disable RemoteAsset %}
    <img class="clothing-rack__hook" src="{{ 'hook.png' | asset_url }}" width="130" height="116" alt="" loading="lazy" draggable="false">
    {% # theme-check-enable RemoteAsset %}
  {% endif %}
{% endcapture %}

{% # Hanger body + hook, for products without a rack image; garments with one bring their own hanger %}
{% capture hanger_img %}
  {% if section.settings.hanger_image != blank %}
    {{ section.settings.hanger_image | image_url: width: 400 | image_tag: class: 'clothing-rack__hanger-img', alt: '', loading: 'lazy', draggable: 'false' }}
  {% else %}
    {% # theme-check-disable RemoteAsset %}
    <img class="clothing-rack__hanger-img" src="{{ 'rack-hanger-body.png' | asset_url }}" width="400" height="160" alt="" loading="lazy" draggable="false">
    {% # theme-check-enable RemoteAsset %}
  {% endif %}
  {{ hook_img }}
{% endcapture %}

{% # Dark patch on the pipe where the hook presses on it (sits between the rail and the hook) %}
{% capture hook_back %}<span class="clothing-rack__contact" aria-hidden="true"></span>{% endcapture %}

<clothing-rack
  class="section-clothing-rack section-clothing-rack--{{ section.settings.image_style }} full-width"
  data-swing="{{ section.settings.swing }}"
  style="
    --rack-garment-width: {{ section.settings.garment_width }}px;
    --rack-spacing: {{ section.settings.spacing }}px;
    --rack-res: {{ section.settings.rack_image_scale }};
    --rack-max-h: {{ max_rack_h }};
    --rack-ink: {{ section.settings.text_color | default: '#f4ede2' }};
    --rack-rail-image: url('{{ rail_url }}');
  "
>
  <div class="clothing-rack__stage">
    <div class="clothing-rack__viewport" data-rack-viewport tabindex="0" role="region" aria-label="{{ 'clothing_rack.label' | t | escape }}">
      <ul class="clothing-rack__track" role="list">
        {% # The rail is part of the track, so it scrolls with the garments and can sit between the two hook layers %}
        <li class="clothing-rack__rail" role="presentation" aria-hidden="true"></li>
        {% for product in rack_collection.products limit: section.settings.limit %}
          {% liquid
            capture price
              echo product.price | money
              unless product.available
                echo ' — '
                echo 'products.sold_out' | t
              endunless
            endcapture
            assign price = price | strip_html

            assign rack_image = product.metafields.custom.rack_image.value

            # Products without a rack image hang their featured photo on the theme's hanger, unless switched off
            assign skip = false
            assign preview_slot = false
            if section.settings.preview_hung
              assign odd = forloop.index | modulo: 2
              if odd == 0
                assign preview_slot = true
              endif
            endif
            if rack_image == blank and section.settings.show_without_rack_image == false and preview_slot == false
              assign skip = true
            endif
          %}
          {% if skip %}{% continue %}{% endif %}
          {% liquid
            if first_title == blank
              assign first_title = product.title
              assign first_price = price
              assign first_url = product.url
            endif

            assign garment_image = rack_image | default: product.featured_image
            # Hook-less garment PNG (rack image): drawn at its pixel size, with our hook added on top
            assign hookless = false
            assign rack_w = 0
            if rack_image != blank
              assign hookless = true
              assign rack_w = rack_image.width
            endif

            assign use_placeholder_hookless = false
            if rack_image == blank and preview_slot
              assign use_placeholder_hookless = true
              assign hookless = true
              # The sample is a 1× image: scale it up with the setting so it keeps its size
              assign rack_w = section.settings.rack_image_scale | times: 500
            endif

            if hookless
              # On-screen width at the default size: source px × (hanger width / 400) / image scale
              assign hookless_sizes = rack_w | times: section.settings.garment_width | times: 0.8 | divided_by: 400.0 | divided_by: section.settings.rack_image_scale | ceil | append: 'px'
            endif

            assign loading = 'lazy'
            assign priority = 'auto'
            if section.index <= 2 and forloop.index <= 5
              assign loading = 'eager'
              if forloop.first
                assign priority = 'high'
              endif
            endif
          %}
          <li class="clothing-rack__item" data-rack-item>
            {{ hook_back }}
            <div class="clothing-rack__hanger" data-rack-swing>
              {% unless hookless %}{{ hanger_img }}{% endunless %}
              {% # --rack-ar lets wide shots (sleeves spread out) hang wider instead of shrinking; --rack-w is a rack image's pixel width %}
              <a
                class="clothing-rack__garment{% if hookless %} clothing-rack__garment--hookless{% endif %}"
                {% if hookless %}
                  style="--rack-w: {{ rack_w }}"
                {% elsif garment_image.aspect_ratio %}
                  style="--rack-ar: {{ garment_image.aspect_ratio }}"
                {% endif %}
                href="{{ product.url }}"
                data-rack-title="{{ product.title | escape }}"
                data-rack-price="{{ price | escape }}"
                aria-label="{{ product.title | escape }}, {{ price | escape }}"
                draggable="false"
              >
                {% if use_placeholder_hookless %}
                  {% # theme-check-disable RemoteAsset %}
                  <img class="clothing-rack__img" src="{{ 'rack-placeholder-hookless.png' | asset_url }}" width="500" height="662" alt="" loading="{{ loading }}" draggable="false">
                  {% # theme-check-enable RemoteAsset %}
                {% elsif hookless %}
                  {{
                    rack_image
                    | image_url: width: 2000
                    | image_tag:
                      loading: loading,
                      fetchpriority: priority,
                      widths: '240,480,720,1000,1400,2000',
                      sizes: hookless_sizes,
                      class: 'clothing-rack__img',
                      draggable: 'false',
                      alt: ''
                  }}
                {% elsif garment_image != blank %}
                  {{
                    garment_image
                    | image_url: width: 700
                    | image_tag:
                      loading: loading,
                      fetchpriority: priority,
                      widths: '240,320,480,640,700',
                      sizes: image_sizes,
                      class: 'clothing-rack__img',
                      draggable: 'false',
                      alt: ''
                  }}
                {% else %}
                  {% render 'clothing-rack-garment', index: forloop.index0, uid: section.id %}
                {% endif %}
              </a>
              {% # The hook goes on top of the garment's neck stub %}
              {% if hookless %}{{ hook_img }}{% endif %}
            </div>
          </li>
        {% else %}
          {% # Empty store or collection: drawn placeholder garments on the hanger PNG %}
          {% assign first_title = 'catalogue.placeholder_title' | t %}
          {% assign first_price = 4900 | money | strip_html %}
          {% for i in (1..8) %}
            {% assign placeholder_price = 4900 | times: i | money | strip_html %}
            <li class="clothing-rack__item" data-rack-item>
              {{ hook_back }}
              <div class="clothing-rack__hanger" data-rack-swing>
                {{ hanger_img }}
                <span class="clothing-rack__garment" data-rack-title="{{ first_title | escape }}" data-rack-price="{{ placeholder_price | escape }}">
                  {% render 'clothing-rack-garment', index: forloop.index0, uid: section.id %}
                </span>
              </div>
            </li>
          {% endfor %}
        {% endfor %}

        {% if rack_collection.products_count > section.settings.limit %}
          {% assign see_all = 'clothing_rack.see_all' | t %}
          <li class="clothing-rack__item clothing-rack__item--see-all" data-rack-item>
            {{ hook_back }}
            <div class="clothing-rack__hanger" data-rack-swing>
              {{ hanger_img }}
              <a class="clothing-rack__sign" href="{{ rack_collection.url }}" data-rack-title="{{ see_all | escape }}" data-rack-price="" draggable="false">
                {{ see_all }} <span aria-hidden="true">&gt;&gt;</span>
              </a>
            </div>
          </li>
        {% endif %}
      </ul>
    </div>
  </div>

  {% comment %}
    Name + price of the selected (centred) garment, or the hovered one. Mouse users can click the name;
    it's hidden from assistive tech because each garment link already carries the same label.
  {% endcomment %}
  <div class="clothing-rack__label" aria-hidden="true">
    <a class="clothing-rack__label-title" href="{{ first_url | default: rack_collection.url }}" tabindex="-1" data-rack-output-title>{{ first_title | escape }}</a>
    <p class="clothing-rack__label-price" data-rack-output-price>{{ first_price | escape }}</p>
  </div>
</clothing-rack>

{% schema %}
{
  "name": "Clothing rack",
  "tag": "section",
  "class": "clothing-rack-section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Leave empty to hang the collection being viewed, or all products on other pages."
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products on the rack",
      "min": 4,
      "max": 24,
      "step": 1,
      "default": 12
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#f4ede2",
      "info": "Product name and price under the rack."
    },
    {
      "type": "header",
      "content": "Garments"
    },
    {
      "type": "select",
      "id": "image_style",
      "label": "Product images",
      "options": [
        { "value": "cutout", "label": "Cut-out (transparent PNG)" },
        { "value": "photo", "label": "Photo" }
      ],
      "default": "cutout",
      "info": "Uses each product's first image. To hang a PNG of the garment on a hook-less hanger instead (our hook is added), add it to the product's \"Rack image\" metafield (custom.rack_image)."
    },
    {
      "type": "checkbox",
      "id": "show_without_rack_image",
      "label": "Show products without a rack image",
      "default": true,
      "info": "On: a product with no rack image hangs its first product photo on the theme's hanger. Off: only products with a rack image (custom.rack_image) are on the rack. The \"Products on the rack\" limit is applied first, so fewer may show."
    },
    {
      "type": "range",
      "id": "rack_image_scale",
      "label": "Rack image resolution",
      "min": 1,
      "max": 4,
      "step": 1,
      "unit": "×",
      "default": 1,
      "info": "Rack images are drawn at their pixel size next to the 400 px hanger. If you export them at 2× (a 1000 px wide image for a garment that is 500 px wide at 1×), set 2."
    },
    {
      "type": "range",
      "id": "garment_width",
      "label": "Garment size",
      "min": 140,
      "max": 320,
      "step": 10,
      "unit": "px",
      "default": 250
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Space between hangers",
      "min": -60,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 8,
      "info": "Negative values overlap garments like a packed rack."
    },
    {
      "type": "range",
      "id": "swing",
      "label": "Swing",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 5
    },
    {
      "type": "header",
      "content": "Rack artwork"
    },
    {
      "type": "image_picker",
      "id": "rail_image",
      "label": "Rail",
      "info": "Transparent PNG that repeats across the screen; the pipe fills the full height (tube.png is 2456×46 px). Leave empty for the default tube."
    },
    {
      "type": "image_picker",
      "id": "hanger_image",
      "label": "Hanger",
      "info": "Transparent PNG, 400×160 px, without the hook: stem axis at x 199.5, top of the neck at y 68. Leave empty for the placeholder."
    },
    {
      "type": "image_picker",
      "id": "hook_image",
      "label": "Hook",
      "info": "Transparent PNG, 130×116 px, drawn in front of the rail: bowl centre at (100, 31), stem axis at x 104.5. Leave empty for the placeholder."
    },
    {
      "type": "checkbox",
      "id": "preview_hung",
      "label": "Preview hook-less garment placeholders",
      "default": false,
      "info": "Temporary: shows a sample hook-less garment PNG (with our hook added) on every other hanger that has no rack image yet."
    }
  ],
  "presets": [
    {
      "name": "Clothing rack"
    }
  ]
}
{% endschema %}
