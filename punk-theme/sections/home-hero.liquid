<section
  class="home-hero full-width"
  style="
    --hero-logo-shadow: {{ section.settings.logo_shadow | divided_by: 100.0 }};
    --hero-logo-blend: {{ section.settings.logo_blend | default: 'normal' }};
    --hero-btn-shadow: {{ section.settings.button_shadow | divided_by: 100.0 }};
    --hero-btn-glow: {{ section.settings.button_glow | divided_by: 100.0 }};
  "
>
  {% # The only heading on the home page: the logo is an image, so the shop name is given to search engines and screen readers here %}
  <h1 class="visually-hidden">{{ shop.name }}</h1>

  {% comment %}
    Every picture in the hero is on screen when the page opens, so none is lazy-loaded and the logo
    (the biggest one) is fetched first. Each is offered in several widths; `sizes` says how wide it
    is drawn, so a phone doesn't download the desktop file.
    Curtains are cropped to the screen height, so they are drawn about 48% of that height wide.
  {% endcomment %}
  {% render 'asset-image',
    file: 'leftcurtain.png',
    class: 'home-hero__curtain home-hero__curtain--left',
    widths: '400,600,800,1200',
    sizes: '48vh',
    width: 1433,
    height: 2994,
    loading: 'eager'
  %}
  {% render 'asset-image',
    file: 'rightcurtain.png',
    class: 'home-hero__curtain home-hero__curtain--right',
    widths: '400,600,800,1200',
    sizes: '48vh',
    width: 1445,
    height: 3000,
    loading: 'eager'
  %}

  {% liquid
    # The logo is drawn 85% of the screen height tall (about 65% of it wide), never wider than 80% of the screen
    assign logo_sizes = '(max-width: 768px) 80vw, min(80vw, 65vh)'
    assign logo_alt = section.settings.logo_alt | default: shop.name
  %}
  <div class="home-hero__logo">
    {% if section.settings.logo != blank %}
      {{
        section.settings.logo
        | image_url: width: 2000
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          widths: '400,600,800,1000,1200,1600,2000',
          sizes: logo_sizes,
          alt: logo_alt,
          class: 'home-hero__logo-img'
      }}
    {% else %}
      {% render 'asset-image',
        file: 'biglogo.png',
        class: 'home-hero__logo-img',
        alt: logo_alt,
        widths: '400,600,800,1100,1500,2000',
        sizes: logo_sizes,
        width: 2185,
        height: 2872,
        loading: 'eager',
        fetchpriority: 'high'
      %}
    {% endif %}
  </div>

  {% assign products_href = section.settings.products_link | default: routes.all_products_collection_url %}
  {% assign products_label = section.settings.products_label | default: 'Products' %}
  <a
    class="home-hero__products-btn"
    href="{{ products_href }}"
    aria-label="{{ products_label | escape }}"
  >
    {% # 80% of the screen height tall (60% on phones), so about 16% / 12% of that height wide %}
    {% render 'asset-image',
      file: 'shoerope.png',
      class: 'home-hero__products-btn-img',
      widths: '200,300,400,767',
      sizes: '(max-width: 768px) 12vh, 16vh',
      width: 767,
      height: 3873,
      loading: 'eager'
    %}
  </a>
</section>

{% stylesheet %}
  .home-hero {
    position: relative;
    height: 100svh;
    overflow: hidden;
    display: grid;
    place-items: center;
    padding: 0 5vw;
  }

  /* ── Logo (centre) ── */
  /* The blend mode sits on the wrapper so the logo mixes with the page background behind it */
  .home-hero__logo {
    display: flex;
    align-items: center;
    justify-content: center;
    mix-blend-mode: var(--hero-logo-blend, normal);
  }

  .home-hero__logo-img {
    display: block;
    width: min(80vw, calc(85svh * 2185 / 2872));
    height: auto;
    max-width: none;
    filter: drop-shadow(0 20px 25px rgba(0, 0, 0, var(--hero-logo-shadow)));
  }

  /* ── Products button: a shoe hanging from a rope ── */
  @keyframes pendulum-sway {
    0%, 100% { transform: rotate(-3deg); }
    50%       { transform: rotate(3deg); }
  }

  .home-hero__products-btn {
    position: absolute;
    top: 0;
    right: 25vw;
    z-index: 1;
    display: block;
    transform-origin: top center;
    animation: pendulum-sway 4s ease-in-out infinite;
    filter:
      drop-shadow(0 2px 2px rgba(0, 0, 0, calc(var(--hero-btn-shadow) * 0.75)))
      drop-shadow(0 3px 6px rgba(0, 0, 0, calc(var(--hero-btn-shadow) * 1.25)));
    transition: filter 0.2s ease;
  }

  .home-hero__products-btn:hover,
  .home-hero__products-btn:focus-visible {
    filter:
      drop-shadow(0 2px 2px rgba(0, 0, 0, calc(var(--hero-btn-shadow) * 0.75)))
      drop-shadow(0 3px 6px rgba(0, 0, 0, calc(var(--hero-btn-shadow) * 1.25)))
      drop-shadow(0 0 18px rgba(255, 255, 255, var(--hero-btn-glow)));
  }

  .home-hero__products-btn-img {
    display: block;
    width: auto;
    height: 80svh;
  }

  /* ── Curtains ── */
  .home-hero__curtain {
    position: fixed;
    top: 0;
    width: clamp(30px, 30vw, 300px);
    height: 100svh;
    object-fit: cover;
    pointer-events: none;
    z-index: 100;
  }

  /* Keep the inner (draped) edge anchored; outer edge is cropped if needed */
  .home-hero__curtain--left {
    left: 0;
    object-position: right center;
  }

  .home-hero__curtain--right {
    right: 0;
    object-position: left center;
  }

  /* Visitors who ask for less motion get a still shoe */
  @media (prefers-reduced-motion: reduce) {
    .home-hero__products-btn {
      animation: none;
    }
  }

  @media (max-width: 768px) {
    .home-hero__products-btn-img {
      height: 60svh;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Homepage hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Override logo image"
    },
    {
      "type": "text",
      "id": "logo_alt",
      "label": "Logo alt text",
      "default": "Elena Store logo"
    },
    {
      "type": "select",
      "id": "logo_blend",
      "label": "Logo blend mode",
      "info": "How the logo mixes with the background behind it. Multiply drops light areas, Screen drops dark areas.",
      "default": "normal",
      "options": [
        { "value": "normal", "label": "Normal" },
        { "value": "multiply", "label": "Multiply" },
        { "value": "screen", "label": "Screen" },
        { "value": "overlay", "label": "Overlay" },
        { "value": "darken", "label": "Darken" },
        { "value": "lighten", "label": "Lighten" },
        { "value": "color-dodge", "label": "Color dodge" },
        { "value": "color-burn", "label": "Color burn" },
        { "value": "hard-light", "label": "Hard light" },
        { "value": "soft-light", "label": "Soft light" },
        { "value": "difference", "label": "Difference" },
        { "value": "exclusion", "label": "Exclusion" },
        { "value": "hue", "label": "Hue" },
        { "value": "saturation", "label": "Saturation" },
        { "value": "color", "label": "Color" },
        { "value": "luminosity", "label": "Luminosity" }
      ]
    },
    {
      "type": "text",
      "id": "products_label",
      "label": "Products button label",
      "info": "Read out by screen readers; the shoe itself has no text.",
      "default": "Products"
    },
    {
      "type": "url",
      "id": "products_link",
      "label": "Products button link",
      "default": "/collections/all"
    },
    {
      "type": "header",
      "content": "Shadows"
    },
    {
      "type": "range",
      "id": "logo_shadow",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Logo shadow",
      "default": 0
    },
    {
      "type": "range",
      "id": "button_shadow",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Button shadow",
      "default": 40
    },
    {
      "type": "range",
      "id": "button_glow",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Shoe hover glow",
      "default": 75
    }
  ],
  "presets": [
    {
      "name": "Homepage hero"
    }
  ]
}
{% endschema %}
