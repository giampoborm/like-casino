{% comment %}
  Product page, gallery view: taped photo gallery plus title, description and
  add-to-cart, tuned from the section schema and its text blocks. Layout is set by the section schema (desktop: horizontal strip or
  vertical stack with the text on either side; mobile: horizontal or vertical).

  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

{{ 'product-wall.css' | asset_url | stylesheet_tag }}
{{ 'product-text.css' | asset_url | stylesheet_tag }}

{% comment %}
  LCG pseudo-random seeded by product.id.
  Same product → same layout every render. Different products → different layouts.
  Each property steps the RNG independently so values don't correlate.
{% endcomment %}
{% assign rng = product.id | modulo: 65535 | plus: 1 %}
{% assign mobile_layout = section.settings.mobile_layout | default: 'horizontal' %}
{% assign desktop_layout = section.settings.desktop_layout | default: 'horizontal' %}
{% assign text_side = section.settings.text_side | default: 'right' %}

{% comment %} Tape style: bundled pair per style, optionally overridden by the image pickers. {% endcomment %}
{% assign tape_style = section.settings.tape_style | default: 'black' %}
{% case tape_style %}
  {% when 'masking' %}
    {% assign tape_files = 'masktape1.png,masktape2.png' | split: ',' %}
  {% when 'clear' %}
    {% assign tape_files = 'cleartape1.png,cleartape2.png' | split: ',' %}
  {% else %}
    {% assign tape_files = 'tape1.png,tape2.png' | split: ',' %}
{% endcase %}

{% assign s = section.settings %}
{% assign action_style = s.action_style | default: 'buttons' %}
{% assign back_url = collection.url | default: '/collections/all' %}

{% comment %}
  Numeric tweaks (sizes, spacing, positions) are emitted as CSS variables in a
  scoped <style> block. "Reset layout to defaults" skips them all, so the CSS
  fallbacks (the schema defaults) apply while the saved values are kept.
  The mobile values only apply when "Customise for mobile" is on.
{% endcomment %}
{% unless s.reset_layout %}
  <style>
    #shopify-section-{{ section.id }} .product-page,
    #shopify-section-{{ section.id }} .product-boot-back {
      --boot-w: {{ s.boot_width }}px;
      --boot-string: {{ s.boot_string }}px;
      --boot-swing: {{ s.boot_swing | times: 0.025 }}deg;
      --boot-shadow: {{ s.boot_shadow | divided_by: 100.0 }};
    }
    #shopify-section-{{ section.id }} .product-page {
      --gallery-width: {{ s.gallery_width }}%;
      --photo-scale: {{ s.photo_size | divided_by: 100.0 }};
      --photo-gap: {{ s.photo_spacing }}px;
      --scatter-scale: {{ s.photo_scatter | divided_by: 100.0 }};
      --rotation-scale: {{ s.photo_tilt | divided_by: 100.0 }};
      --tape-scale: {{ s.tape_size | divided_by: 100.0 }};
    }
    #shopify-section-{{ section.id }} .product-text {
      --text-width: {{ s.text_width }};
      --text-scale: {{ s.text_scale | divided_by: 100.0 }};
      --text-x: {{ s.text_x }}px;
      --text-y: {{ s.text_y }}px;
    }
    #shopify-section-{{ section.id }} .product-boot-back {
      --boot-size: {{ s.back_boot_size | divided_by: 100.0 }};
      --boot-x: {{ s.back_boot_x }}px;
      --boot-y: {{ s.back_boot_y }}px;
    }
    {% for block in section.blocks %}
      #product-block-{{ block.id }} {
        --block-size: {{ block.settings.size | divided_by: 100.0 }};
        --block-x: {{ block.settings.offset_x }}px;
        --block-y: {{ block.settings.offset_y }}px;
      }
    {% endfor %}
    {% if s.mobile_custom %}
      @media (max-width: 640px) {
        #shopify-section-{{ section.id }} .product-page,
        #shopify-section-{{ section.id }} .product-boot-back {
          --boot-w: {{ s.mobile_boot_width }}px;
          --boot-string: {{ s.mobile_boot_string }}px;
        }
        #shopify-section-{{ section.id }} .product-page {
          --photo-scale: {{ s.mobile_photo_size | divided_by: 100.0 }};
          --photo-gap: {{ s.mobile_photo_spacing }}px;
          --scatter-scale: {{ s.mobile_photo_scatter | divided_by: 100.0 }};
          --rotation-scale: {{ s.mobile_photo_tilt | divided_by: 100.0 }};
          --tape-scale: {{ s.mobile_tape_size | divided_by: 100.0 }};
        }
        #shopify-section-{{ section.id }} .product-text {
          --text-width: {{ s.mobile_text_width }};
          --text-scale: {{ s.mobile_text_scale | divided_by: 100.0 }};
          --text-x: {{ s.mobile_text_x }}px;
          --text-y: {{ s.mobile_text_y }}px;
        }
        #shopify-section-{{ section.id }} .product-boot-back {
          --boot-size: {{ s.mobile_back_boot_size | divided_by: 100.0 }};
          --boot-x: {{ s.mobile_back_boot_x }}px;
          --boot-y: {{ s.mobile_back_boot_y }}px;
        }
        {% for block in section.blocks %}
          #product-block-{{ block.id }} {
            --block-size: {{ block.settings.mobile_size | divided_by: 100.0 }};
            --block-x: {{ block.settings.mobile_offset_x }}px;
            --block-y: {{ block.settings.mobile_offset_y }}px;
          }
        {% endfor %}
      }
    {% endif %}
  </style>
{% endunless %}

{% if action_style == 'boots' %}
  {% assign back_boot_src = 'backboot.png' | asset_url %}
  {% if s.back_boot_image != blank %}
    {% assign back_boot_src = s.back_boot_image | image_url: width: 600 %}
  {% endif %}
  {% assign buy_boot_src = 'buyboot.png' | asset_url %}
  {% if s.buy_boot_image != blank %}
    {% assign buy_boot_src = s.buy_boot_image | image_url: width: 600 %}
  {% endif %}
  {% assign back_label = 'products.boot_back' | t %}
  {% comment %} Zero-height anchor where the back button used to be: the boot hangs down from it. {% endcomment %}
  <div class="product-boot-back">
    {% render 'hanging-boot',
      src: back_boot_src,
      href: back_url,
      label: back_label,
      hook_x: 57,
      hook_y: 52,
      modifier: 'back'
    %}
  </div>
{% else %}
  <a class="product-breadcrumb" href="{{ back_url }}">&#8592;</a>
{% endif %}

<div
  class="product-page product-page--{{ desktop_layout }}{% if desktop_layout == 'vertical' %} product-page--text-{{ text_side }}{% endif %} full-width"
>
  <div class="product-wall-scroll{% if mobile_layout == 'vertical' %} product-wall-scroll--vertical{% endif %}">
    <div class="product-wall{% if mobile_layout == 'vertical' %} product-wall--vertical{% endif %}">
      {% comment %}
        The first image is the featured/packshot image shown on collection pages,
        so the wall skips it — unless it's the only image the product has.
        The rack image lives in the custom.rack_image metafield, not in product.images.
      {% endcomment %}
      {% for image in product.images %}
        {% if forloop.first and product.images.size > 1 %}{% continue %}{% endif %}

        {% assign rng = rng | times: 1664525 | plus: 1013904223 | modulo: 65536 %}
        {% assign img_rotation = rng | modulo: 51 | minus: 25 | divided_by: 10.0 %}

        {% assign rng = rng | times: 1664525 | plus: 1013904223 | modulo: 65536 %}
        {% assign img_offset = rng | modulo: 150 | minus: 75 %}

        {% assign rng = rng | times: 1664525 | plus: 1013904223 | modulo: 65536 %}
        {% if forloop.first %}
          {% assign img_overlap = 0 %}
        {% else %}
          {% assign img_overlap = rng | modulo: 50 | minus: 15 %}
        {% endif %}

        {% assign rng = rng | times: 1664525 | plus: 1013904223 | modulo: 65536 %}
        {% if forloop.first %}
          {% assign img_z = 1 %}
        {% elsif forloop.index == 2 %}
          {% assign img_z = rng | modulo: 8 | plus: 2 %}
        {% else %}
          {% assign img_z = rng | modulo: 9 | plus: 1 %}
        {% endif %}

        {% assign rng = rng | times: 1664525 | plus: 1013904223 | modulo: 65536 %}
        {% assign tape_variant = rng | modulo: 2 %}
        {% assign tape_url = tape_files[tape_variant] | asset_url %}
        {% if tape_variant == 0 %}
          {% assign tape_suffix = 'a' %}
        {% else %}
          {% assign tape_suffix = 'b' %}
        {% endif %}
        {% assign tape_key = 'tape_' | append: tape_style | append: '_' | append: tape_suffix %}
        {% assign tape_pick = section.settings[tape_key] %}
        {% if tape_pick != blank %}
          {% assign tape_url = tape_pick | image_url: width: 240 %}
        {% endif %}

        {% assign rng = rng | times: 1664525 | plus: 1013904223 | modulo: 65536 %}
        {% assign tape_tl_rot = rng | modulo: 61 | minus: 75 %}
        {% assign rng = rng | times: 1664525 | plus: 1013904223 | modulo: 65536 %}
        {% assign tape_tr_rot = rng | modulo: 61 | plus: 15 %}
        {% assign rng = rng | times: 1664525 | plus: 1013904223 | modulo: 65536 %}
        {% assign tape_bl_rot = rng | modulo: 61 | plus: 15 %}
        {% assign rng = rng | times: 1664525 | plus: 1013904223 | modulo: 65536 %}
        {% assign tape_br_rot = rng | modulo: 61 | minus: 75 %}

        {% assign rng = rng | times: 1664525 | plus: 1013904223 | modulo: 65536 %}
        {% assign img_hoffset = rng | modulo: 26 | plus: 10 %}

        <div
          class="product-wall__photo"
          data-full-src="{{ image | image_url: width: 2000 }}"
          style="--img-rotation: {{ img_rotation }}deg; --img-offset: {{ img_offset }}px; --img-overlap: {{ img_overlap }}px; --img-z: {{ img_z }}; --img-hoffset: {{ img_hoffset }}px; --tape-url: url('{{ tape_url }}'); --tape-tl-rot: {{ tape_tl_rot }}deg; --tape-tr-rot: {{ tape_tr_rot }}deg; --tape-bl-rot: {{ tape_bl_rot }}deg; --tape-br-rot: {{ tape_br_rot }}deg"
        >
          <div class="product-wall__tape product-wall__tape--tl"></div>
          <div class="product-wall__tape product-wall__tape--tr"></div>
          <div class="product-wall__tape product-wall__tape--bl"></div>
          <div class="product-wall__tape product-wall__tape--br"></div>
          {% render 'image', image: image, class: 'product-wall__img' %}
        </div>
      {% endfor %}
    </div>
  </div>

  <div class="product-text">
    {% for block in section.blocks %}

      {% case block.type %}
        {% when 'title' %}
          <h1 class="product-text__title" id="product-block-{{ block.id }}" {{ block.shopify_attributes }}>{{ product.title }}</h1>

        {% when 'description' %}
          {% if product.description != blank %}
            <div class="product-text__description" id="product-block-{{ block.id }}" {{ block.shopify_attributes }}>{{ product.description }}</div>
          {% endif %}

        {% when 'price' %}
          <div class="product-text__price" id="product-block-{{ block.id }}" {{ block.shopify_attributes }}>{{ product.price | money }}</div>

        {% when 'button' %}
          <div class="product-text__actions" id="product-block-{{ block.id }}" {{ block.shopify_attributes }}>
            {% form 'product', product %}
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
              {% if s.sold_out_text != blank %}
                {% assign sold_out_label = s.sold_out_text %}
              {% else %}
                {% assign sold_out_label = 'products.sold_out' | t %}
              {% endif %}
              {% if action_style == 'boots' %}
                {% assign buy_label = 'products.add_to_cart' | t %}
                {% assign buy_disabled = false %}
                {% unless product.available %}{% assign buy_disabled = true %}{% endunless %}
                {% render 'hanging-boot',
                  src: buy_boot_src,
                  label: buy_label,
                  hook_x: 42,
                  hook_y: 53,
                  delay: 0.35,
                  disabled: buy_disabled,
                  modifier: 'buy'
                %}
                {% unless product.available %}
                  <p class="product-text__sold-out-note">{{ sold_out_label }}</p>
                {% endunless %}
              {% else %}
                <button
                  type="submit"
                  class="product-text__btn{% unless product.available %} product-text__btn--sold-out{% endunless %}"
                  {% unless product.available %}disabled{% endunless %}
                >
                  {% if product.available %}
                    {{ 'products.add_to_cart' | t }}
                  {% else %}
                    {{ sold_out_label }}
                  {% endif %}
                </button>
              {% endif %}
            {% endform %}
          </div>
      {% endcase %}
    {% endfor %}
  </div>
</div>

<dialog class="product-wall-lightbox">
  <button class="product-wall-lightbox__btn product-wall-lightbox__close" aria-label="Close">×</button>
  {% # theme-check-disable ImgWidthAndHeight, RemoteAsset %}
  <img src="" alt="">
  {% # theme-check-enable ImgWidthAndHeight, RemoteAsset %}
  <div class="product-wall-lightbox__nav">
    <button class="product-wall-lightbox__btn product-wall-lightbox__prev" aria-label="Previous">←</button>
    <button class="product-wall-lightbox__btn product-wall-lightbox__next" aria-label="Next">→</button>
  </div>
</dialog>

<script>
  (function () {
    const scroll = document.querySelector('.product-wall-scroll');
    const dialog = document.querySelector('.product-wall-lightbox');
    const dialogImg = dialog.querySelector('img');
    const btnClose = dialog.querySelector('.product-wall-lightbox__close');
    const btnPrev = dialog.querySelector('.product-wall-lightbox__prev');
    const btnNext = dialog.querySelector('.product-wall-lightbox__next');
    const photos = Array.from(document.querySelectorAll('.product-wall__photo'));
    let currentIndex = 0;
    let hasDragged = false;

    // Drag-to-scroll
    let startX, scrollLeft;

    scroll.addEventListener('mousedown', (e) => {
      startX = e.pageX - scroll.offsetLeft;
      scrollLeft = scroll.scrollLeft;
      hasDragged = false;
      scroll.classList.add('is-dragging');
    });

    scroll.addEventListener('dragstart', (e) => e.preventDefault());

    window.addEventListener('mouseup', () => {
      scroll.classList.remove('is-dragging');
    });

    scroll.addEventListener('mousemove', (e) => {
      if (!scroll.classList.contains('is-dragging')) return;
      e.preventDefault();
      const x = e.pageX - scroll.offsetLeft;
      if (Math.abs(x - startX) > 4) hasDragged = true;
      scroll.scrollLeft = scrollLeft - (x - startX);
    });

    // Lightbox
    function openAt(index) {
      currentIndex = index;
      dialogImg.src = photos[currentIndex].dataset.fullSrc;
      btnPrev.hidden = currentIndex === 0;
      btnNext.hidden = currentIndex === photos.length - 1;
      if (!dialog.open) dialog.showModal();
    }

    photos.forEach((photo, i) => {
      photo.addEventListener('click', () => {
        if (hasDragged) return;
        openAt(i);
      });
    });

    btnClose.addEventListener('click', () => dialog.close());
    btnPrev.addEventListener('click', () => openAt(currentIndex - 1));
    btnNext.addEventListener('click', () => openAt(currentIndex + 1));

    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft' && currentIndex > 0) openAt(currentIndex - 1);
      if (e.key === 'ArrowRight' && currentIndex < photos.length - 1) openAt(currentIndex + 1);
    });
  })();
</script>

{% schema %}
{
  "name": "Product – gallery view",
  "settings": [
    {
      "type": "header",
      "content": "Reset"
    },
    {
      "type": "checkbox",
      "id": "reset_layout",
      "label": "Reset layout to defaults",
      "info": "Ignores every size, spacing and position value below (including the text blocks). Your values are kept: untick to bring them back.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "mobile_custom",
      "label": "Customise for mobile",
      "info": "Off: phones use the same values as desktop. On: phones use the Mobile fields (bottom of this section and inside each text block).",
      "default": false
    },
    {
      "type": "header",
      "content": "Desktop layout"
    },
    {
      "type": "select",
      "id": "desktop_layout",
      "label": "Desktop gallery layout",
      "options": [
        { "value": "horizontal", "label": "Horizontal (strip above the text)" },
        { "value": "vertical", "label": "Vertical (photos beside the text)" }
      ],
      "default": "horizontal"
    },
    {
      "type": "select",
      "id": "text_side",
      "label": "Text side (vertical)",
      "options": [
        { "value": "right", "label": "Text on the right" },
        { "value": "left", "label": "Text on the left" }
      ],
      "default": "right"
    },
    {
      "type": "range",
      "id": "gallery_width",
      "label": "Gallery width (vertical)",
      "min": 40,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 55
    },
    {
      "type": "header",
      "content": "Photos"
    },
    {
      "type": "paragraph",
      "content": "Applies to desktop and mobile. Mobile can have its own values under \"Mobile\"."
    },
    { "type": "range", "id": "photo_size", "label": "Photo size", "min": 50, "max": 200, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "photo_spacing", "label": "Spacing", "min": -100, "max": 100, "step": 5, "unit": "px", "default": 0 },
    { "type": "range", "id": "photo_scatter", "label": "Scatter", "min": 0, "max": 200, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "photo_tilt", "label": "Tilt", "min": 0, "max": 200, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "tape_size", "label": "Tape size", "min": 50, "max": 200, "step": 5, "unit": "%", "default": 100 },
    {
      "type": "select",
      "id": "tape_style",
      "label": "Tape style",
      "options": [
        { "value": "black", "label": "Black" },
        { "value": "masking", "label": "Masking" },
        { "value": "clear", "label": "Clear" }
      ],
      "default": "black"
    },
    { "type": "image_picker", "id": "tape_black_a", "label": "Black tape A", "info": "Empty = default", "visible_if": "{{ section.settings.tape_style == 'black' }}" },
    { "type": "image_picker", "id": "tape_black_b", "label": "Black tape B", "info": "Empty = default", "visible_if": "{{ section.settings.tape_style == 'black' }}" },
    { "type": "image_picker", "id": "tape_masking_a", "label": "Masking tape A", "info": "Empty = default", "visible_if": "{{ section.settings.tape_style == 'masking' }}" },
    { "type": "image_picker", "id": "tape_masking_b", "label": "Masking tape B", "info": "Empty = default", "visible_if": "{{ section.settings.tape_style == 'masking' }}" },
    { "type": "image_picker", "id": "tape_clear_a", "label": "Clear tape A", "info": "Empty = default", "visible_if": "{{ section.settings.tape_style == 'clear' }}" },
    { "type": "image_picker", "id": "tape_clear_b", "label": "Clear tape B", "info": "Empty = default", "visible_if": "{{ section.settings.tape_style == 'clear' }}" },
    {
      "type": "header",
      "content": "Text area"
    },
    { "type": "range", "id": "text_width", "label": "Width", "min": 30, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "text_scale", "label": "Size", "min": 50, "max": 200, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "text_x", "label": "Position X", "min": -300, "max": 300, "step": 10, "unit": "px", "default": 0 },
    { "type": "range", "id": "text_y", "label": "Position Y", "min": -300, "max": 300, "step": 10, "unit": "px", "default": 0 },
    {
      "type": "header",
      "content": "Action buttons"
    },
    {
      "type": "select",
      "id": "action_style",
      "label": "Style",
      "options": [
        { "value": "buttons", "label": "Buttons" },
        { "value": "boots", "label": "Hanging boots" }
      ],
      "default": "buttons"
    },
    { "type": "text", "id": "sold_out_text", "label": "Sold out text", "info": "Empty = default" },
    { "type": "range", "id": "boot_width", "label": "Boot width", "min": 80, "max": 300, "step": 5, "unit": "px", "default": 140, "visible_if": "{{ section.settings.action_style == 'boots' }}" },
    { "type": "range", "id": "boot_string", "label": "Lace length", "info": "Long = leaves the screen", "min": 100, "max": 3000, "step": 100, "unit": "px", "default": 1500, "visible_if": "{{ section.settings.action_style == 'boots' }}" },
    { "type": "range", "id": "boot_swing", "label": "Sway", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100, "visible_if": "{{ section.settings.action_style == 'boots' }}" },
    { "type": "range", "id": "boot_shadow", "label": "Boot shadow", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50, "visible_if": "{{ section.settings.action_style == 'boots' }}" },
    { "type": "range", "id": "back_boot_size", "label": "Back boot size", "min": 50, "max": 200, "step": 5, "unit": "%", "default": 100, "visible_if": "{{ section.settings.action_style == 'boots' }}" },
    { "type": "range", "id": "back_boot_x", "label": "Back boot X", "min": -300, "max": 300, "step": 10, "unit": "px", "default": 0, "visible_if": "{{ section.settings.action_style == 'boots' }}" },
    { "type": "range", "id": "back_boot_y", "label": "Back boot Y", "min": -300, "max": 300, "step": 10, "unit": "px", "default": 0, "visible_if": "{{ section.settings.action_style == 'boots' }}" },
    { "type": "image_picker", "id": "back_boot_image", "label": "Back boot image", "info": "Empty = default", "visible_if": "{{ section.settings.action_style == 'boots' }}" },
    { "type": "image_picker", "id": "buy_boot_image", "label": "Buy boot image", "info": "Empty = default", "visible_if": "{{ section.settings.action_style == 'boots' }}" },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile gallery layout",
      "options": [
        { "value": "horizontal", "label": "Horizontal (scroll sideways)" },
        { "value": "vertical", "label": "Vertical (stack downward)" }
      ],
      "default": "vertical"
    },
    {
      "type": "header",
      "content": "Mobile – photos",
      "visible_if": "{{ section.settings.mobile_custom }}"
    },
    { "type": "range", "id": "mobile_photo_size", "label": "Photo size", "min": 50, "max": 200, "step": 5, "unit": "%", "default": 100, "visible_if": "{{ section.settings.mobile_custom }}" },
    { "type": "range", "id": "mobile_photo_spacing", "label": "Spacing", "min": -100, "max": 100, "step": 5, "unit": "px", "default": 0, "visible_if": "{{ section.settings.mobile_custom }}" },
    { "type": "range", "id": "mobile_photo_scatter", "label": "Scatter", "min": 0, "max": 200, "step": 5, "unit": "%", "default": 100, "visible_if": "{{ section.settings.mobile_custom }}" },
    { "type": "range", "id": "mobile_photo_tilt", "label": "Tilt", "min": 0, "max": 200, "step": 5, "unit": "%", "default": 100, "visible_if": "{{ section.settings.mobile_custom }}" },
    { "type": "range", "id": "mobile_tape_size", "label": "Tape size", "min": 50, "max": 200, "step": 5, "unit": "%", "default": 100, "visible_if": "{{ section.settings.mobile_custom }}" },
    {
      "type": "header",
      "content": "Mobile – text area",
      "visible_if": "{{ section.settings.mobile_custom }}"
    },
