<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% # The main font is used by all text: fetch it with the page instead of after the CSS is parsed %}
    {% if settings.font_main_bundled %}
      {{ 'cella.regular.otf' | asset_url | preload_tag: as: 'font', type: 'font/otf', crossorigin: 'anonymous' }}
    {% endif %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body>
    <a class="skip-link visually-hidden" href="#MainContent">Skip to content</a>

    {% unless request.page_type == 'index' %}
      {% sections 'header-group' %}
    {% endunless %}

    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% # No footer on cart: the fixed checkout lamp owns the bottom edge %}
    {% unless request.page_type == 'index' or request.page_type == 'cart' %}
      {% sections 'footer-group' %}
    {% endunless %}

    {% # Cookie banner and other fixed overlays: every page, home included %}
    {% sections 'overlay-group' %}
  </body>
</html>
